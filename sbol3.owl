    <!-- https://identifiers.org/edam:format_1207 -->

    <owl:Class rdf:about="https://identifiers.org/edam:format_1207">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/edam:format_1915"/>
        <rdfs:comment>Alphabet for a nucleotide sequence with possible ambiguity, unknown positions and non-sequence characters.</rdfs:comment>
        <rdfs:label>nucleotide</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/edam:format_1208 -->

    <owl:Class rdf:about="https://identifiers.org/edam:format_1208">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/edam:format_1915"/>
        <rdfs:comment>Alphabet for a protein sequence with possible ambiguity, unknown positions and non-sequence characters.</rdfs:comment>
        <rdfs:label>protein</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/edam:format_1915 -->

    <owl:Class rdf:about="https://identifiers.org/edam:format_1915">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>A defined way or layout of representing and structuring data in a computer file, blob, string, message, or elsewhere.</rdfs:comment>
        <rdfs:label>Format</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/edam:format_2585 -->

    <owl:Class rdf:about="https://identifiers.org/edam:format_2585">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/edam:format_1915"/>
        <rdfs:comment>Systems Biology Markup Language (SBML), the standard XML format for models of biological processes such as for example metabolism, cell signaling, and gene regulation.</rdfs:comment>
        <rdfs:label>SBML</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/edam:format_3156 -->

    <owl:Class rdf:about="https://identifiers.org/edam:format_3156">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/edam:format_1915"/>
        <rdfs:comment>BioPAX is an exchange format for pathway data, with its data model defined in OWL.</rdfs:comment>
        <rdfs:label>BioPAX</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/edam:format_3240 -->

    <owl:Class rdf:about="https://identifiers.org/edam:format_3240">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/edam:format_1915"/>
        <rdfs:comment>CellML, the format for mathematical models of biological and other networks.</rdfs:comment>
        <rdfs:label>CellML</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3.org/ns/prov#Activity -->

    <owl:Class rdf:about="https://www.w3.org/ns/prov#Activity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>An Activity is used to represent the execution of a process or set of processes. An Activity is linked through prov:qualifiedAssociation to one or more Associations, and is linked through prov:used to one or more Entities.</rdfs:comment>
        <rdfs:label>Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3.org/ns/prov#Agent -->

    <owl:Class rdf:about="https://www.w3.org/ns/prov#Agent">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>An Agent is something that bears some form of responsibility for an Activity taking place, such as a person, organization, or software agent.</rdfs:comment>
        <rdfs:label>Agent</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3.org/ns/prov#Association -->

    <owl:Class rdf:about="https://www.w3.org/ns/prov#Association">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3.org/ns/prov#agent"/>
                <owl:someValuesFrom rdf:resource="https://www.w3.org/ns/prov#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An Association is used to link an Activity to one or more Agents, and to describe the role of each Agent in the execution of the Activity. An Association is linked through prov:qualifiedAssociation to an Activity, and is linked through prov:agent to one or more Agents.</rdfs:comment>
        <rdfs:label>Association</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3.org/ns/prov#Plan -->

    <owl:Class rdf:about="https://www.w3.org/ns/prov#Plan">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>A Plan is used to describe a set of actions or steps intended to achieve a specific goal or outcome.</rdfs:comment>
        <rdfs:label>Plan</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3.org/ns/prov#Usage -->

    <owl:Class rdf:about="https://www.w3.org/ns/prov#Usage">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>A Usage is used to describe the involvement of an Entity in an Activity, specifying how the Entity was used during the execution of the Activity.</rdfs:comment>
        <rdfs:label>Usage</rdfs:label>
    </owl:Class>
    


