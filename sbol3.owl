        <rdfs:label>SBOL Association</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SBOLBinaryPrefix -->

    <owl:Class rdf:about="http://sbols.org/v3#SBOLBinaryPrefix">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SBOLPrefix"/>
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/BinaryPrefix"/>
        <otol:domainEntity>true</otol:domainEntity>
