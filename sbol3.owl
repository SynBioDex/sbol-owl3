        <otol:vocabulary>true</otol:vocabulary>
        <rdfs:comment>The SBOLTerm class is a way to create a placeholder for a term in an SBOL-controlled vocabulary.</rdfs:comment>
        <rdfs:label>SBOL Term</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SBOLUnit -->

    <owl:Class rdf:about="http://sbols.org/v3#SBOLUnit">
