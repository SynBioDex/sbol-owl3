        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <otol:domainEntity>true</otol:domainEntity>
        <otol:replacementOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:comment>A wrapper class to enable the use of OM Units in SBOL. This class allows adding custom SBOL relationships.</rdfs:comment>
        <rdfs:label>SBOLUnit</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SBOLUnitDivision -->

    <owl:Class rdf:about="http://sbols.org/v3#SBOLUnitDivision">
