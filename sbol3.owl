        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SBOLUnit"/>
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitMultiplication"/>
        <otol:domainEntity>true</otol:domainEntity>
        <otol:replacementOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitMultiplication"/>
        <rdfs:comment>A wrapper class to enable the use of OM UnitMultiplications in SBOL. This class allows adding custom SBOL relationships.</rdfs:comment>
        <rdfs:label>SBOLUnitMultiplication</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SBOLUsage -->

    <owl:Class rdf:about="http://sbols.org/v3#SBOLUsage">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Identified"/>
        <rdfs:subClassOf rdf:resource="https://www.w3.org/ns/prov#Usage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3.org/ns/prov#entity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <otol:domainEntity>true</otol:domainEntity>
        <otol:replacementOf rdf:resource="https://www.w3.org/ns/prov#Usage"/>
        <rdfs:comment>A wrapper for the PROV-O Usage class. The purpose of this class is to allow for the inclusion of SBOL-specific properties on PROV Usages, such as the association of a Usage with a particular Component or Interaction.</rdfs:comment>
        <rdfs:label>SBOL Usage</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SBOLValue -->

    <owl:Class rdf:about="http://sbols.org/v3#SBOLValue">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <otol:vocabulary>true</otol:vocabulary>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SMILESSequence -->

    <owl:Class rdf:about="http://sbols.org/v3#SMILESSequence">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#SequenceWithElements"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#encoding"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/edam:format_1196"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SequenceWithElements"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>Represents a chemical structure using the Simplified Molecular-Input Line-Entry System (SMILES) format, with the encoding of EDAM format 1196. The elements property MUST contain a valid SMILES string.</rdfs:comment>
        <rdfs:label>SMILES Sequence</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#Sequence -->

    <owl:Class rdf:about="http://sbols.org/v3#Sequence">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#TopLevel"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>The purpose of the Sequence class is to represent the primary structure of a Component object and the manner in which it is encoded.</rdfs:comment>
        <rdfs:label>Sequence</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SequenceFeature -->

    <owl:Class rdf:about="http://sbols.org/v3#SequenceFeature">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sbols.org/v3#hasLocation"/>
                <owl:someValuesFrom rdf:resource="http://sbols.org/v3#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>The SequenceFeature class describes one or more regions of interest on the Sequence objects referred to by its parent Component.</rdfs:comment>
        <rdfs:label>SequenceFeature</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SequenceWithElements -->

    <owl:Class rdf:about="http://sbols.org/v3#SequenceWithElements">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Sequence"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#encoding"/>
                        <owl:someValuesFrom rdf:resource="http://sbols.org/v3#Encoding"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#elements"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Sequence"/>
        <rdfs:comment>A SequenceWithElements is a Sequence that contains elements and an encoding.</rdfs:comment>
        <rdfs:label>Sequence With Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SequentialRestriction -->

    <owl:Class rdf:about="http://sbols.org/v3#SequentialRestriction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#contains"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#equals"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#finishes"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#meets"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#overlaps"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#precedes"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#starts"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#strictlyContains"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#strictlyPrecedes"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <otol:constantList>true</otol:constantList>
        <rdfs:comment>Sequential restrictions are a subset of the ConstraintRestriction class that are used to express relative, sequence-based positions of pairs of Features within a template Component. The value of a SequentialRestriction must be one of the following: precedes, strictlyPrecedes, meets, overlaps, contains, strictlyContains, equals, starts, or finishes.</rdfs:comment>
        <rdfs:label>SequentialRestriction</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SimpleChemicalComponent -->

    <owl:Class rdf:about="http://sbols.org/v3#SimpleChemicalComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Component"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#role"/>
                        <owl:someValuesFrom rdf:resource="http://sbols.org/v3#SmallMoleculeRole"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#type"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SBO:0000247"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#hasSequence"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://sbols.org/v3#InChISequence"/>
                                    <rdf:Description rdf:about="http://sbols.org/v3#SMILESSequence"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Component"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>Represents a simple chemical component, with the type of SBO:simple_chemical, the role of SmallMoleculeRole. It restricts instances to have the sequences with the correct chemical encoding.</rdfs:comment>
        <rdfs:label>Simple Chemical Component</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SmallMoleculeRole -->

    <owl:Class rdf:about="http://sbols.org/v3#SmallMoleculeRole">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://identifiers.org/CHEBI:35224"/>
                    <rdf:Description rdf:about="https://identifiers.org/CHEBI:50906"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ComponentRole"/>
        <otol:constantList>true</otol:constantList>
        <rdfs:comment>Controlled vocabulary for the roles that a Small Molecule Component can play in a design. The value of a Component&apos;s role property must be an instance of a class that is a subclass of SmallMoleculeRole.</rdfs:comment>
        <rdfs:label>Small Molecule Role</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#StimulatedParticipation -->

    <owl:Class rdf:about="http://sbols.org/v3#StimulatedParticipation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Participation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#role"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SBO:0000643"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Participation"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>Represents a participation of a feature that is stimulated in an interaction, with the role of SBO:stimulated.</rdfs:comment>
        <rdfs:label>StimulatedParticipation</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#StimulationInteraction -->

    <owl:Class rdf:about="http://sbols.org/v3#StimulationInteraction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Interaction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#hasParticipation"/>
                        <owl:someValuesFrom rdf:resource="http://sbols.org/v3#StimulatedParticipation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#hasParticipation"/>
                        <owl:someValuesFrom rdf:resource="http://sbols.org/v3#StimulatorParticipation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#type"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SBO:0000170"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Interaction"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>Represents a stimulation interaction, with the type of SBO:stimulation, that involves at least one stimulator participation and at least one stimulated participation.</rdfs:comment>
        <rdfs:label>StimulationInteraction</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#StimulatorParticipation -->

    <owl:Class rdf:about="http://sbols.org/v3#StimulatorParticipation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Participation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#role"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SBO:0000459"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Participation"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>Represents a participation of a feature that stimulates an interaction, with the role of SBO:stimulator.</rdfs:comment>
        <rdfs:label>StimulatorParticipation</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SubComponent -->

    <owl:Class rdf:about="http://sbols.org/v3#SubComponent">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sbols.org/v3#instanceOf"/>
                <owl:someValuesFrom rdf:resource="http://sbols.org/v3#Component"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>The SubComponent class is a subclass of the Feature class that can be used to specify structural hierarchy.</rdfs:comment>
        <rdfs:label>SubComponent</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#TemplateParticipation -->

    <owl:Class rdf:about="http://sbols.org/v3#TemplateParticipation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Participation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#role"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SBO:0000645"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Participation"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>Represents a participation of a feature that is a template in an interaction, with the role of SBO:template.</rdfs:comment>
        <rdfs:label>TemplateParticipation</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#TerminatorDNAComponent -->

    <owl:Class rdf:about="http://sbols.org/v3#TerminatorDNAComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#DNAComponent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#role"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SO:0000141"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#DNAComponent"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>Represents a terminator DNA component, with the role of SO:terminator.</rdfs:comment>
        <rdfs:label>Terminator DNA Component</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#TopLevel -->

    <owl:Class rdf:about="http://sbols.org/v3#TopLevel">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Identified"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sbols.org/v3#hasNamespace"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>TopLevel is an abstract class that is extended by any Identified class that can be found at the top level of an SBOL document or file.</rdfs:comment>
        <rdfs:label>TopLevel</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#TopologyRestriction -->

    <owl:Class rdf:about="http://sbols.org/v3#TopologyRestriction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#contains"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#covers"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#equals"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#isDisjointFrom"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#meets"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#overlaps"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#strictlyContains"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <otol:constantList>true</otol:constantList>
        <rdfs:comment>Topology restrictions are a subset of the ConstraintRestriction class that are used to express topological relationships between pairs of Features within a template Component. The value of a TopologyRestriction must be one of the following: contains, strictlyContains, equals, covers, overlaps, meets, or isDisjointFrom.</rdfs:comment>
        <rdfs:label>TopologyRestriction</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#TranscriptionFactorProteinComponent -->

    <owl:Class rdf:about="http://sbols.org/v3#TranscriptionFactorProteinComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#ProteinComponent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#role"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/GO:0003700"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ProteinComponent"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>Represents a transcription factor protein component, with the role of GO:DNA-binding transcription factor activity.</rdfs:comment>
        <rdfs:label>Transcription Factor Protein Component</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#VariableFeature -->

    <owl:Class rdf:about="http://sbols.org/v3#VariableFeature">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Identified"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sbols.org/v3#cardinality"/>
                <owl:someValuesFrom rdf:resource="http://sbols.org/v3#Cardinality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sbols.org/v3#variable"/>
                <owl:someValuesFrom rdf:resource="http://sbols.org/v3#Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:comment>VariableFeature class specifies a variable and set of values that will replace one of the Feature objects in the template of a CombinatorialDerivation. The variable is specified by the variable property, and the set of values is defined by the union of Component objects referred to by the variant, variantCollection, and variantDerivation properties.</rdfs:comment>
        <rdfs:label>VariableFeature</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#contains -->

    <owl:Class rdf:about="http://sbols.org/v3#contains">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The subject contains the object and they might or might not share a boundary.</rdfs:comment>
        <rdfs:label>contains</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#covers -->

    <owl:Class rdf:about="http://sbols.org/v3#covers">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The subject contains the object but also shares a boundary.</rdfs:comment>
        <rdfs:label>covers</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#differentFrom -->

    <owl:Class rdf:about="http://sbols.org/v3#differentFrom">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The subject and object, after tracing through any layers of ComponentReference, MUST NOT both refer to SubComponent objects with the same instanceOf value or both refer to ExternallyDefined objects with the same definition. Example: two fluorescent reporters must be different.</rdfs:comment>
        <rdfs:label>differentFrom</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#enumerate -->

    <owl:Class rdf:about="http://sbols.org/v3#enumerate">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#CombinatorialDerivationStrategy"/>
        <rdfs:comment>Enumerate is a strategy for deriving new Components from a template Component. The enumerate strategy specifies that a new Component should be derived for every possible combination of values for the variable specified by the VariableFeature objects in the template Component.</rdfs:comment>
        <rdfs:label>enumerate</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#equals -->

    <owl:Class rdf:about="http://sbols.org/v3#equals">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The subject and object occupy the same location in space.</rdfs:comment>
        <rdfs:label>equals</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#finishes -->

    <owl:Class rdf:about="http://sbols.org/v3#finishes">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The start of the location for subject is after the start of the location for object and the end of the location for subject is equal to the end of the location for object.</rdfs:comment>
        <rdfs:label>finishes</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#inline -->

    <owl:Class rdf:about="http://sbols.org/v3#inline">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Orientation"/>
        <rdfs:comment>Inline is an attribute of the feature, where the feature is in the 5&apos; to 3&apos; direction.</rdfs:comment>
        <rdfs:label>inline</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#isDisjointFrom -->

    <owl:Class rdf:about="http://sbols.org/v3#isDisjointFrom">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The subject and object do not overlap in space.</rdfs:comment>
        <rdfs:label>isDisjointFrom</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#meets -->

    <owl:Class rdf:about="http://sbols.org/v3#meets">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The subject and object are connected at a shared boundary.</rdfs:comment>
        <rdfs:label>meets</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#mergeRoles -->

    <owl:Class rdf:about="http://sbols.org/v3#mergeRoles">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#RoleIntegration"/>
        <rdfs:comment>Use the union of the two sets: both the set of zero or more role properties given for this SubComponent as well as the set of zero or more role properties given for the included Component.</rdfs:comment>
        <rdfs:label>mergeRoles</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#one -->

    <owl:Class rdf:about="http://sbols.org/v3#one">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Cardinality"/>
        <rdfs:comment>Exactly one Feature in the derived Component SHOULD have a prov:wasDerivedFrom property that refers to the template Feature.</rdfs:comment>
        <rdfs:label>one</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#oneOrMore -->

    <owl:Class rdf:about="http://sbols.org/v3#oneOrMore">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Cardinality"/>
        <rdfs:comment>At least one Feature in the derived Component SHOULD have a prov:wasDerivedFrom property that refers to the template Feature.</rdfs:comment>
        <rdfs:label>OneOrMore</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#oppositeOrientationAs -->

    <owl:Class rdf:about="http://sbols.org/v3#oppositeOrientationAs">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#OrientationRestriction"/>
        <rdfs:comment>The subject and object Component objects MUST have opposite orientations.</rdfs:comment>
        <rdfs:label>oppositeOrientationAs</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#overlaps -->

    <owl:Class rdf:about="http://sbols.org/v3#overlaps">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The subject and object overlap in space, but portions of each are outside of the other.</rdfs:comment>
        <rdfs:label>overlaps</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#overrideRoles -->

    <owl:Class rdf:about="http://sbols.org/v3#overrideRoles">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#RoleIntegration"/>
        <rdfs:comment>In the context of this SubComponent, ignore any role given for the included Component. Instead use only the set of zero or more role properties given for this SubComponent.</rdfs:comment>
        <rdfs:label>overrideRoles</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#precedes -->

    <owl:Class rdf:about="http://sbols.org/v3#precedes">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The start of the location for subject is less than the start of the location for object.</rdfs:comment>
        <rdfs:label>precedes</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#replaces -->

    <owl:Class rdf:about="http://sbols.org/v3#replaces">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>In the context of the parent object of the Constraint, information about the subject should be used in place of all instances of the object. Example: the J23101 promoter replaces a generic promoter.</rdfs:comment>
        <rdfs:label>replaces</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#reverseComplement -->

    <owl:Class rdf:about="http://sbols.org/v3#reverseComplement">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Orientation"/>
        <rdfs:comment>Reverse complement is an attribute of the feature, where the feature is in the 3&apos; to 5&apos; direction.</rdfs:comment>
        <rdfs:label>reverseComplement</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#sameOrientationAs -->

    <owl:Class rdf:about="http://sbols.org/v3#sameOrientationAs">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#OrientationRestriction"/>
        <rdfs:comment>The subject and object Component objects MUST have the same orientation. </rdfs:comment>
        <rdfs:label>sameOrientationAs</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#sample -->

    <owl:Class rdf:about="http://sbols.org/v3#sample">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#CombinatorialDerivationStrategy"/>
        <rdfs:comment>Sample is a strategy for deriving new Components from a template Component. The sample strategy specifies that a new Component should be derived for a random sample of the possible combinations of values for the variable specified by the VariableFeature objects in the template Component.</rdfs:comment>
        <rdfs:label>sample</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#starts -->

    <owl:Class rdf:about="http://sbols.org/v3#starts">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The start of the location for subject is equal to the start of the location for object and the end of the location for subject is before the end of the location for object.</rdfs:comment>
        <rdfs:label>starts</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#strictlyContains -->

    <owl:Class rdf:about="http://sbols.org/v3#strictlyContains">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The subject entirely contains the object: they do not share a boundary.</rdfs:comment>
        <rdfs:label>strictlyContains</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#strictlyPrecedes -->

    <owl:Class rdf:about="http://sbols.org/v3#strictlyPrecedes">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The end of the location for subject is less than the start of the location for object.</rdfs:comment>
        <rdfs:label>strictlyPrecedes</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#verifyIdentical -->

    <owl:Class rdf:about="http://sbols.org/v3#verifyIdentical">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The subject and object, after tracing through any layers of ComponentReference, MUST both refer to SubComponent objects with the same instanceOf value or both refer to ExternallyDefined objects with the same definition. Example: a promoter included via two different subsystems must be the identical.</rdfs:comment>
        <rdfs:label>verifyIdentical</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#zeroOrMore -->

    <owl:Class rdf:about="http://sbols.org/v3#zeroOrMore">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Cardinality"/>
        <rdfs:comment>Any number of Feature objects in the derived Component MAY have prov:wasDerivedFrom properties that refer to the template Feature.</rdfs:comment>
        <rdfs:label>zeroOrMore</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#zeroOrOne -->

    <owl:Class rdf:about="http://sbols.org/v3#zeroOrOne">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Cardinality"/>
        <rdfs:comment>No more than one Feature in the derived Component SHOULD have a prov:wasDerivedFrom property that refers to the template Feature.</rdfs:comment>
        <rdfs:label>zeroOrOne</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/BinaryPrefix -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/BinaryPrefix">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Prefix"/>
        <rdfs:comment>The purpose of the om:BinaryPrefix class is to describe standard binary prefixes such as &quot;kibi&quot;, &quot;mebi&quot;, &quot;gibi&quot;, etc.</rdfs:comment>
        <rdfs:label>BinaryPrefix</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/CompoundUnit -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/CompoundUnit">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:comment>om:CompoundUnit is an abstract class that is extended by other classes to describe units of measure that can be represented as combinations of multiple other units of measure.</rdfs:comment>
        <rdfs:label>CompoundUnit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Measure -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit"/>
                <owl:someValuesFrom rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The purpose of the om:Measure class is to link a numerical value to a om:Unit.</rdfs:comment>
        <rdfs:label>Measure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Prefix -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Prefix">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasFactor"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/symbol"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>om:Prefix is an abstract class that is extended by other classes to describe factors that are  commonly represented by standard unit prefixes.</rdfs:comment>
        <rdfs:label>Prefix</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/PrefixedUnit -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/PrefixedUnit">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasPrefix"/>
                <owl:someValuesFrom rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Prefix"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit"/>
                <owl:someValuesFrom rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The purpose of the om:PrefixedUnit class is to describe a unit of measure that is the multiplication of another unit of measure and a factor represented by a standard prefix such as &quot;milli&quot;, &quot;centi&quot;, &quot;kilo&quot;, etc.</rdfs:comment>
        <rdfs:label>PrefixedUnit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/SIPrefix -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/SIPrefix">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Prefix"/>
        <rdfs:comment>The purpose of the om:SIPrefix class is to describe standard SI prefixes such as &quot;milli&quot;, &quot;centi&quot;, &quot;kilo&quot;, etc.</rdfs:comment>
        <rdfs:label>SIPrefix</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/SingularUnit -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/SingularUnit">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:comment>The purpose of the om:SingularUnit class is to describe a unit of measure that is not explicitly represented as a combination of multiple units, but could be equivalent to such a representation.</rdfs:comment>
        <rdfs:label>SingularUnit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Unit -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/symbol"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>om:Unit is an abstract class that is extended by other classes to describe units of measure using a shared set of properties.</rdfs:comment>
        <rdfs:label>Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/UnitDivision -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitDivision">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasDenominator"/>
                <owl:someValuesFrom rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumerator"/>
                <owl:someValuesFrom rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The purpose of the om:UnitDivision class is to describe a unit of measure that is the division of one unit of measure by another.</rdfs:comment>
        <rdfs:label>UnitDivision</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/UnitExponentiation -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitExponentiation">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasBase"/>
                <owl:someValuesFrom rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasExponent"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The purpose of the om:UnitExponentiation class is to describe a unit of measure that is raised to an integer power.</rdfs:comment>
        <rdfs:label>UnitExponentiation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/UnitMultiplication -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitMultiplication">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasTerm1"/>
                <owl:someValuesFrom rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasTerm2"/>
                <owl:someValuesFrom rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The purpose of the om:UnitMultiplication class is to describe a unit of measure that is the multiplication of two other units of measure.</rdfs:comment>
        <rdfs:label>UnitMultiplication</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/CHEBI:35224 -->

    <owl:Class rdf:about="https://identifiers.org/CHEBI:35224">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/CHEBI:50906"/>
        <rdfs:comment>A small molecule which increases (activator) or decreases (inhibitor) the activity of an (allosteric) enzyme by binding to the enzyme at the regulatory site (which is different from the substrate-binding catalytic site).</rdfs:comment>
        <rdfs:label>effector</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/CHEBI:50906 -->

    <owl:Class rdf:about="https://identifiers.org/CHEBI:50906">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>A role is particular behaviour which a material entity may exhibit.</rdfs:comment>
        <rdfs:label>material entity role</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/GO:0003674 -->

    <owl:Class rdf:about="https://identifiers.org/GO:0003674">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>A molecular process that can be carried out by the action of a single macromolecular machine, usually via direct physical interactions with other molecular entities. Function in this sense denotes an action, or activity, that a gene product (or a complex) performs.</rdfs:comment>
        <rdfs:label>molecular_function</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/GO:0003700 -->

    <owl:Class rdf:about="https://identifiers.org/GO:0003700">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/GO:0003674"/>
        <rdfs:comment>A transcription regulator activity that modulates transcription of gene sets via selective and non-covalent binding to a specific double-stranded genomic DNA sequence (sometimes referred to as a motif) within a cis-regulatory region. Regulatory regions include promoters (proximal and distal) and enhancers. Genes are transcriptional units, and include bacterial operons.</rdfs:comment>
        <rdfs:label>DNA-binding transcription factor activity</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000000 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000000">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Representation of an entity used in a systems biology knowledge reconstruction, such as a model, pathway, network.</rdfs:comment>
        <rdfs:label>systems biology representation</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000003 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000003">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000000"/>
        <rdfs:comment>The function of a physical or conceptual entity, that is its role, in the execution of an event or process.</rdfs:comment>
        <rdfs:label>participant role</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000004 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000004">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000000"/>
        <rdfs:comment>Set of assumptions that underlay a mathematical description.</rdfs:comment>
        <rdfs:label>modelling framework</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000010 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000010">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000003"/>
        <rdfs:comment>Substance consumed by a chemical reaction. Reactants react with each other to form the products of a chemical reaction. In a chemical equation the Reactants are the elements or compounds on the left hand side of the reaction equation. A reactant can be consumed and produced by the same reaction, its global quantity remaining unchanged.</rdfs:comment>
        <rdfs:label>reactant</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000011 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000011">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000003"/>
        <rdfs:comment>Substance that is produced in a reaction. In a chemical equation the Products are the elements or compounds on the right hand side of the reaction equation. A product can be produced and consumed by the same reaction, its global quantity remaining unchanged.</rdfs:comment>
        <rdfs:label>product</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000019 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000019">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000003"/>
        <rdfs:comment>Substance that changes the velocity of a process without itself being consumed or transformed by the reaction.</rdfs:comment>
        <rdfs:label>modifier</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000020 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000020">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000019"/>
        <rdfs:comment>Substance that decreases the probability of a chemical reaction without itself being consumed or transformed by the reaction.</rdfs:comment>
        <rdfs:label>inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000062 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000062">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000004"/>
        <rdfs:comment>Modelling approach where the quantities of participants are considered continuous, and represented by real values. The associated simulation methods make use of differential equations.</rdfs:comment>
        <rdfs:label>continuous framework</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000063 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000063">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000004"/>
        <rdfs:comment>Modelling approach where the quantities of participants are considered discrete, and represented by integer values. The associated simulation methods can be deterministic or stochastic.</rdfs:comment>
        <rdfs:label>discrete framework</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000167 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000167">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000231"/>
        <rdfs:comment>An event involving physical entities that results in modification of structure, location, or free energy.</rdfs:comment>
        <rdfs:label>biochemical or transport reaction</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000168 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000168">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000231"/>
        <rdfs:comment>Synonym: regulation</rdfs:comment>
        <rdfs:label>control</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000169 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000169">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000168"/>
        <rdfs:comment>Negative modulation of the execution of a process.</rdfs:comment>
        <rdfs:label>inhibition</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000170 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000170">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000168"/>
        <rdfs:comment>Positive modulation of the execution of a process.</rdfs:comment>
        <rdfs:label>stimulation</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000176 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000176">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000167"/>
        <rdfs:comment>An event involving one or more chemical entities that modifies the electrochemical structure of at least one of the participants.</rdfs:comment>
        <rdfs:label>biochemical reaction</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000177 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000177">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000176"/>
        <rdfs:comment>Synonym: association</rdfs:comment>
        <rdfs:label>non-covalent binding</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000179 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000179">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000176"/>
        <rdfs:comment>Complete disappearance of a physical entity.</rdfs:comment>
        <rdfs:label>degradation</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000231 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000231">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000000"/>
        <rdfs:comment>Representation of an entity that manifests, unfolds or develops through time, such as a discrete event, or a mutual or reciprocal action or influence that happens between participating physical entities, and/or other occurring entities.</rdfs:comment>
        <rdfs:label>occurring entity representation</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000234 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000234">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000004"/>
        <rdfs:comment>Modelling approach, pioneered by Rene Thomas and Stuart Kaufman, where the evolution of a system is described by the transitions between discrete activity states of &apos;genes&apos; that control each other.</rdfs:comment>
        <rdfs:label>logical framework</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000236 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000236">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000000"/>
        <rdfs:comment>Synonym: new synonym</rdfs:comment>
        <rdfs:label>physical entity representation</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000241 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000241">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000236"/>
        <rdfs:comment>A real thing, defined by its properties or the actions it performs, rather than it physico-chemical structure.</rdfs:comment>
        <rdfs:label>functional entity</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000247 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000247">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000236"/>
        <rdfs:comment>Simple, non-repetitive chemical entity.</rdfs:comment>
        <rdfs:label>simple chemical</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000250 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000250">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000236"/>
        <rdfs:comment>Synonym: RNA</rdfs:comment>
        <rdfs:label>ribonucleic acid</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000251 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000251">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000236"/>
        <rdfs:comment>Synonym: DNA</rdfs:comment>
        <rdfs:label>deoxyribonucleic acid</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000252 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000252">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000236"/>
        <rdfs:comment>Naturally occurring macromolecule formed by the repetition of amino-acid residues linked by peptidic bonds. A polypeptide chain is synthesized by the ribosome.</rdfs:comment>
        <rdfs:label>polypeptide chain</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000253 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000253">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000236"/>
        <rdfs:comment>Entity composed of several independant components that are not linked by covalent bonds.</rdfs:comment>
        <rdfs:label>non-covalent complex</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000289 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000289">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000003"/>
        <rdfs:comment>Logical or physical subset of the event space that contains pools, that is sets of participants considered identical when it comes to the event they are involved into. A compartment can have any number of dimensions, including 0, and be of any size including null.</rdfs:comment>
        <rdfs:label>functional compartment</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000459 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000459">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000019"/>
        <rdfs:comment>Synonym: activator</rdfs:comment>
        <rdfs:label>stimulator</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000589 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000589">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000231"/>
        <rdfs:comment>A composite biochemical process through which a gene sequence is fully converted into mature gene products. These gene products may include RNA species as well as proteins, and the process encompasses all intermediate steps required to generate the active form of the gene product.</rdfs:comment>
        <rdfs:label>genetic production</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000598 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000598">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000003"/>
        <rdfs:comment>A region of DNA to which various transcription factors and RNA polymerase must bind in order to initiate transcription for a gene.</rdfs:comment>
        <rdfs:label>promoter</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000642 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000642">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000003"/>
        <rdfs:comment>Conceptual or material entity that is the object of an inhibition process, and is acted upon by an inhibitor.</rdfs:comment>
        <rdfs:label>inhibited</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000643 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000643">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000003"/>
        <rdfs:comment>Conceptual or material entity that is the object of a stimulation process, and is acted upon by a stimulator.</rdfs:comment>
        <rdfs:label>stimulated</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000644 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000644">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000003"/>
        <rdfs:comment>Conceptual or material entity that is the object of a modification process, and is acted upon by a modifier.</rdfs:comment>
        <rdfs:label>modified</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000645 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000645">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000003"/>
        <rdfs:comment>An entity that acts as the starting material for genetic production (http://identifiers.org/biomodels.sbo/SBO:0000589).</rdfs:comment>
        <rdfs:label>template</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000681 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000681">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000004"/>
        <rdfs:comment>Modeling approach which combines multiple canonical modeling frameworks. For example, a hybrid model could consider both continuous (represented by real values) and discrete (represented by integers) participants. Hybrid models are executed with hybrid simulation algorithms. For example, a hybrid continuous-discrete model may be simulation using a combination of stochastic simulation and ordinary differential equations.</rdfs:comment>
        <rdfs:label>hybrid framework</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SBO:0000693 -->

    <owl:Class rdf:about="https://identifiers.org/SBO:0000693">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SBO:0000004"/>
        <rdfs:comment>Modelling approach which captures bounds on the possible behavior of a system, which may be further reduced using an objective function.</rdfs:comment>
        <rdfs:label>constraint-based framework</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000057 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000057">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000110"/>
        <rdfs:comment>Moved to transcriptional_cis_regulatory_region (SO:0001055) from gene_group_regulatory_region (SO:0000752) on 11 Feb 2021 when SO:0000752 was merged into SO:0001055. See GitHub Issue #529. A regulatory element of an operon to which activators or repressors bind thereby effecting translation of genes in that operon.</rdfs:comment>
        <rdfs:label>operator</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000110 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000110">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Any extent of continuous biological sequence.</rdfs:comment>
        <rdfs:label>sequence_feature</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000139 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000139">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000110"/>
        <rdfs:comment>Region in mRNA where ribosome assembles.</rdfs:comment>
        <rdfs:label>ribosome_entry_site</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000141 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000141">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000110"/>
        <rdfs:comment>Moved from transcription_regulatory_region (SO:0001679) to transcriptional_cis_regulatory_region (SO:0001055) by Dave Sant on Feb 11, 2021 when transcription_regulatory_region was merged into transcriptional_cis_regulatory_region to be consistent with GO and reduce redundancy as part of the GREEKC consortium. See GitHub Issue #527. The sequence of DNA located either at the end of the transcript that causes RNA polymerase to terminate transcription.</rdfs:comment>
        <rdfs:label>terminator</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000167 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000167">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000110"/>
        <rdfs:comment>This term is mapped to MGED. Do not obsolete without consulting MGED ontology. The region on a DNA molecule involved in RNA polymerase binding to initiate transcription. Moved from is_a: SO:0001055 transcriptional_cis_regulatory_region as per request from GREEKC initiative in August 2020. Merged with RNA_polymerase_promoter (SO:0001203) Aug 2020. Moved up one level from is_a CRM (SO:0000727) to is_a transcriptional_cis_regulatory_region (SO:0001055) as part of the GREEKC work January 2021. Pascale Gaudet from Gene Ontology pointed out that CRM can be located upstream of the promoter and therefore cannot include the promoter. A regulatory_region composed of the TSS(s) and binding sites for TF_complexes of the core transcription machinery. A region (DNA) to which RNA polymerase binds, to begin transcription.</rdfs:comment>
        <rdfs:label>promoter</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000234 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000234">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000110"/>
        <rdfs:comment>An mRNA does not contain introns as it is a processed_transcript. The equivalent kind of primary_transcript is protein_coding_primary_transcript (SO:0000120) which may contain introns. This term is mapped to MGED. Do not obsolete without consulting MGED ontology. Messenger RNA is the intermediate molecule between DNA and protein. It includes UTR and coding sequences. It does not contain introns.</rdfs:comment>
        <rdfs:label>mRNA</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000316 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000316">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000110"/>
        <rdfs:comment>A contiguous sequence which begins with, and includes, a start codon and ends with, and includes, a stop codon.</rdfs:comment>
        <rdfs:label>CDS</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000400 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000400">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>An attribute describes a quality of sequence.</rdfs:comment>
        <rdfs:label>sequence_attribute</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000704 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000704">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000110"/>
        <rdfs:comment>This term is mapped to MGED. Do not obsolete without consulting MGED ontology. A gene may be considered as a unit of inheritance. A region (or regions) that includes all of the sequence elements necessary to encode a functional transcript. A gene may include regulatory regions, transcribed regions and/or other functional sequence regions.</rdfs:comment>
        <rdfs:label>gene</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000804 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000804">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000110"/>
        <rdfs:comment>A region that is engineered.</rdfs:comment>
        <rdfs:label>engineered_region</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000984 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000984">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000400"/>
        <rdfs:comment>Attributes added to describe the different kinds of replicon. SO workshop, September 2006. When a nucleotide polymer has only one strand.</rdfs:comment>
        <rdfs:label>single</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000985 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000985">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000400"/>
        <rdfs:comment>Attributes added to describe the different kinds of replicon. SO workshop, September 2006. When a nucleotide polymer has two strands that are reverse-complement to one another and pair together.</rdfs:comment>
        <rdfs:label>double</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000987 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000987">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000400"/>
        <rdfs:comment>Attributes added to describe the different kinds of replicon. SO workshop, September 2006. A quality of a nucleotide polymer that has a 3&apos;-terminal residue and a 5&apos;-terminal residue.</rdfs:comment>
        <rdfs:label>linear</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0000988 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0000988">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000400"/>
        <rdfs:comment>Attributes added to describe the different kinds of replicon. SO workshop, September 2006. A quality of a nucleotide polymer that has no terminal nucleotide residues.</rdfs:comment>
        <rdfs:label>circular</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0001030 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0001030">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000400"/>
        <rdfs:comment>Forward is an attribute of the feature, where the feature is in the 5&apos; to 3&apos; direction.</rdfs:comment>
        <rdfs:label>forward</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/SO:0001031 -->

    <owl:Class rdf:about="https://identifiers.org/SO:0001031">
        <rdfs:subClassOf rdf:resource="https://identifiers.org/SO:0000400"/>
        <rdfs:comment>Reverse is an attribute of the feature, where the feature is in the 3&apos; to 5&apos; direction. Again could be applied to primer.</rdfs:comment>
        <rdfs:label>reverse</rdfs:label>
    </owl:Class>
    


    <!-- https://identifiers.org/edam:format_1196 -->

    <owl:Class rdf:about="https://identifiers.org/edam:format_1196">
