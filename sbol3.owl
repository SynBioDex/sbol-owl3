        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <otol:domainEntity>true</otol:domainEntity>
        <otol:replacementOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:comment>A wrapper for the OM Measure class. The purpose of this class is to allow for the inclusion of SBOL-specific properties on OM Measures, such as the association of a Measure with a particular Component or Interaction.</rdfs:comment>
        <rdfs:label>SBOL Measure</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#SBOLPlan -->

    <owl:Class rdf:about="http://sbols.org/v3#SBOLPlan">
