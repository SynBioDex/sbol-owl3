    <!-- http://sbols.org/v3#SBOLCompoundUnit -->

    <owl:Class rdf:about="http://sbols.org/v3#SBOLCompoundUnit">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SBOLUnit"/>
