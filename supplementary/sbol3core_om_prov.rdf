    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InhibitedParticipation</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a participation of a feature that is inhibited in an interaction, with the role of SBO:inhibited.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
