    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Component MAY have any number of hasModel properties, each of type IRI, that MUST reference a Model object.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.w3.org/ns/prov#wasInformedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.w3.org/ns/prov#Activity"/>
    <rdfs:range rdf:resource="https://www.w3.org/ns/prov#Activity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wasInformedBy</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An prov:Activity MAY have one or more prov:wasInformedBy properties, each of type IRI that refers to another prov:Activity object.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#strictlyPrecedes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">strictlyPrecedes</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The end of the location for subject is less than the start of the location for object.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#InhibitedParticipation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
