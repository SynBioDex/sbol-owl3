    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Controlled vocabulary for the roles that a Small Molecule Component can play in a design. The value of a Component's role property must be an instance of a class that is a subclass of SmallMoleculeRole.</rdfs:comment>
    <otol:constantList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:constantList>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#SBOLActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#TopLevel"/>
    <rdfs:subClassOf rdf:resource="https://www.w3.org/ns/prov#Activity"/>
    <otol:replacementOf rdf:resource="https://www.w3.org/ns/prov#Activity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBOL Activity</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A wrapper for the PROV Activity class. The purpose of this class is to allow for the inclusion of SBOL-specific properties on PROV Activities, such as the association of an Activity with a particular Component or Interaction.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
