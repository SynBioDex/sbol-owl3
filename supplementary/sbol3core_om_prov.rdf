  <rdf:Description rdf:about="http://sbols.org/v3#RoleIntegration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SBOLTerm"/>
