  <rdf:Description rdf:about="http://sbols.org/v3#SBOLSIPrefix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SBOLPrefix"/>
    <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/SIPrefix"/>
    <otol:replacementOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/SIPrefix"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBOLSIPrefix</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A wrapper class to enable the use of OM SIPrefixes in SBOL. This class allows adding custom SBOL relationships.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.w3.org/ns/prov#hadRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="N9a1f6ffea9424273bba413e5133aa045"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hadRole</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An prov:Usage MAY have one or more prov:hadRole properties, each of type IRI that refers to particular term(s) describing the usage of an prov:Entity referenced by the prov:entity property.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#NonCovalentBindingInteraction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
