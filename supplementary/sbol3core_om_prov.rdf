  <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/PrefixedUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
    <rdfs:subClassOf rdf:nodeID="N486e29e399c44e3b8d832e335b397b1d"/>
