  <rdf:Description rdf:about="http://sbols.org/v3#EntireSequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Location"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EntireSequence</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The EntireSequence class does not have any additional properties. Use of this class indicates that the linked Sequence describes the entirety of the Component or Feature parent of this Location object.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/SIPrefix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
