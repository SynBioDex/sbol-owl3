  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#strictlyContains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">strictlyContains</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The subject entirely contains the object: they do not share a boundary.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#hasFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
    <rdfs:domain rdf:resource="http://sbols.org/v3#Component"/>
    <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasFeature</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Component MAY have any number of hasFeature properties, each of type IRI that MUST reference a Feature object</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/hasDenominator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitDivision"/>
    <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDenominator</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The om:hasDenominator property is REQUIRED and MUST contain a IRI that refers to another om:Unit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N87e3cfb9801a45979bdaa590aa789c0b">
    <rdf:first rdf:resource="http://sbols.org/v3#EntireSequence"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
