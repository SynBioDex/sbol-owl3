  <rdf:Description rdf:about="http://sbols.org/v3#InteractionType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SBOLValue"/>
    <owl:equivalentClass rdf:nodeID="N3960799a6bb247aeaab21db14b446bf2"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InteractionType</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provides a vocabulary to choose the interaction type of behavior represented by an Interaction. Interaction types are typically identified using IRIs, such as terms from the Systems Biology Ontology.</rdfs:comment>
    <otol:constantList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:constantList>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#ModifiedParticipation">
