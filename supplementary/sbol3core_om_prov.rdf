  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#SBOLUnitExponentiation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SBOLUnit"/>
    <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitExponentiation"/>
    <otol:replacementOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitExponentiation"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBOLUnitExponentiation</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A wrapper class to enable the use of OM UnitExponentiations in SBOL. This class allows adding custom SBOL relationships.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#Range">
