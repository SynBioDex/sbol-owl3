    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Component MUST have one or more type properties, each of type IRI specifying the category of biochemical or physical entity (for example DNA, protein, or simple chemical) that a Component object abstracts for the purpose of engineering design</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#Identified">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
