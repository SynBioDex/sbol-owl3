  <rdf:Description rdf:about="http://sbols.org/v3#SmallMoleculeRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ComponentRole"/>
    <owl:equivalentClass rdf:nodeID="N3e5a34a9470044a49f0de4f92983c695"/>
