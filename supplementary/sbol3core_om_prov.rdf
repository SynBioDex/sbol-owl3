    <owl:equivalentClass rdf:nodeID="N9e4c7c77512742af8f0f25c107a3ed72"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene DNA Component</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a gene DNA component, with the role of SO:gene.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7e2e4dfa11cc4a76b1090808328650c7">
