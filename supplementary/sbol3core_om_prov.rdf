    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasTerm1</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The om:hasTerm1 property is REQUIRED and MUST contain a IRI that refers to another om:Unit. This om:Unit is the first multiplication term.</rdfs:comment>
  </rdf:Description>
