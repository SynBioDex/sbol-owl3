    <owl:equivalentClass rdf:nodeID="N98ce7a60c8514e40af566b3dc9cfe3f1"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NonCovalentBindingInteraction</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a non-covalent binding interaction, with the type of SBO:non_covalent_binding, that involves at least one reactant participation and at least one product participation.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
