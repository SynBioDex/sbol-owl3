    <owl:equivalentClass rdf:nodeID="N6822bfd549e94f39b6c5a5f76e84cb96"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TemplateParticipation</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a participation of a feature that is a template in an interaction, with the role of SBO:template.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
