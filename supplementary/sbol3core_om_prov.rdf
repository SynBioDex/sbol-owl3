  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#SequentialRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
    <owl:equivalentClass rdf:nodeID="N45c35e73553b455cb922f44df2c2ae28"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SequentialRestriction</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sequential restrictions are a subset of the ConstraintRestriction class that are used to express relative, sequence-based positions of pairs of Features within a template Component. The value of a SequentialRestriction must be one of the following: precedes, strictlyPrecedes, meets, overlaps, contains, strictlyContains, equals, starts, or finishes.</rdfs:comment>
    <otol:constantList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:constantList>
  </rdf:Description>
