    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents an inhibition interaction, with the type of SBO:inhibition, that involves at least one inhibitor participation and at least one inhibited participation.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
