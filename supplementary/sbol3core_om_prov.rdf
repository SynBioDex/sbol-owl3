    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ModelFramework</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provides a vocabulary to choose the modeling framework of a Model. Model frameworks are typically identified using IRIs, such as terms from the Systems Biology Ontology.</rdfs:comment>
    <otol:constantList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:constantList>
  </rdf:Description>
