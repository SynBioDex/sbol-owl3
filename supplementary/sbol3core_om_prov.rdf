    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All SBOL-defined classes are directly or indirectly derived from the Identified abstract class.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#ConstraintRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
