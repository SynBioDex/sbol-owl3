    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Interface MAY have any number of nondirectional properties, each of type IRI, that MUST reference a Feature object in the same Component.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#hasModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
