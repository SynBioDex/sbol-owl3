    <owl:onProperty rdf:resource="http://sbols.org/v3#hasParticipation"/>
    <owl:onClass rdf:resource="http://sbols.org/v3#ModifierParticipation"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#ComponentReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Feature"/>
    <rdfs:subClassOf rdf:nodeID="N537f8eaf1bf145408d6006704d6e05e8"/>
    <rdfs:subClassOf rdf:nodeID="Na7c42c75bf374ac7808e963981dba4b3"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ComponentReference</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The ComponentReference class is a subclass of Feature that can be used to reference Features within SubComponents.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#instanceOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://sbols.org/v3#SubComponent"/>
    <rdfs:range rdf:resource="http://sbols.org/v3#Component"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">instanceOf</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The instanceOf property is a REQUIRED IRI that refers to the Component providing the definition for this SubComponent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6ac50fc6be6942498345488527ffcc7b">
    <rdf:first rdf:resource="http://sbols.org/v3#Model"/>
    <rdf:rest rdf:nodeID="N0daf647e8f944178a1ed5d9c1daf139a"/>
  </rdf:Description>
