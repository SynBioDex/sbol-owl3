    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SBOLUnit"/>
    <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/PrefixedUnit"/>
    <otol:replacementOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/PrefixedUnit"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBOLPrefixedUnit</rdfs:label>
