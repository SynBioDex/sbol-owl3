    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The purpose of the om:UnitExponentiation class is to describe a unit of measure that is raised to an integer power.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#ExperimentalData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#TopLevel"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExperimentalData</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The purpose of the ExperimentalData class is to aggregate links to experimental data files. An ExperimentalData is typically associated with a single sample, lab instrument, or experimental condition and can be used to describe the output of the test phase of a design-build-test-learn workflow.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#inline">
