    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SIPrefix</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The purpose of the om:SIPrefix class is to describe standard SI prefixes such as "milli", "centi", "kilo", etc.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.w3.org/ns/prov#entity">
