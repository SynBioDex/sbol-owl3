AnnotationProperty: otol:constantList

    Annotations: 
        rdfs:comment "If true, create an enum list.",
        rdfs:label "Constant list"
    
    
AnnotationProperty: otol:domainEntity

    Annotations: 
        rdfs:comment "If true, indicates that the term corresponds to a domain entity. Software automation tools should create a specific entity.",
        rdfs:label "domainEntity"
    
    
AnnotationProperty: otol:replacementOf

    Annotations: 
        rdfs:comment "If specified, create the entity name according to the value of this property. E.g. for sbol3:SBOLActivity otol:replacementOf prov:Activity, create the entities using the Activity name only.",
        rdfs:label "replacementOf"
    
    
AnnotationProperty: otol:vocabulary

    Annotations: 
        rdfs:comment "If true, an object should be created for the container class.",
        rdfs:label "Vocabulary"
    
    
