        rdfs:comment "Alphabet for a nucleotide sequence with possible ambiguity, unknown positions and non-sequence characters.",
        rdfs:label "nucleotide"
    
    SubClassOf: 
        identifiers:edam:format_1915
    
    
Class: identifiers:edam:format_1208

    Annotations: 
        rdfs:comment "Alphabet for a protein sequence with possible ambiguity, unknown positions and non-sequence characters.",
        rdfs:label "protein"
    
    SubClassOf: 
        identifiers:edam:format_1915
    
    
Class: identifiers:edam:format_1915

    Annotations: 
        rdfs:comment "A defined way or layout of representing and structuring data in a computer file, blob, string, message, or elsewhere.",
        rdfs:label "Format"
    
    SubClassOf: 
        owl:Thing
    
    
Class: identifiers:edam:format_2585

    Annotations: 
        rdfs:comment "Systems Biology Markup Language (SBML), the standard XML format for models of biological processes such as for example metabolism, cell signaling, and gene regulation.",
        rdfs:label "SBML"
    
    SubClassOf: 
        identifiers:edam:format_1915
    
    
Class: identifiers:edam:format_3156

