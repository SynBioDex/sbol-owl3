    SubClassOf: 
        identifiers:SBO:0000231
    
    
Class: identifiers:SBO:0000168

    Annotations: 
        rdfs:comment "Modulation of activity. Modification of the execution of an event or process. Also known as regulation.",
        rdfs:label "Control"
    
    SubClassOf: 
        identifiers:SBO:0000231
    
    
Class: identifiers:SBO:0000169

    Annotations: 
