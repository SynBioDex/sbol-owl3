         and (sbol:role some identifiers:GO:0003700)
    
    SubClassOf: 
        sbol:ProteinComponent
    
    
Class: sbol:VariableFeature

    Annotations: 
        otol:domainEntity "true",
        rdfs:label "VariableFeature"
    
    SubClassOf: 
        sbol:Identified,
        sbol:cardinality some sbol:Cardinality,
        sbol:variable some sbol:Feature
    
    
Class: sbol:contains

    Annotations: 
        rdfs:comment "Subject contains object; they might or might not share a boundary.",
        rdfs:label "contains"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:covers

    Annotations: 
        rdfs:comment "Subject covers object.",
        rdfs:label "covers"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:differentFrom

    Annotations: 
        rdfs:comment "Subject and object must NOT refer to the same Component/definition.",
        rdfs:label "differentFrom"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:enumerate

    Annotations: 
        rdfs:label "enumerate"
    
    SubClassOf: 
        sbol:CombinatorialDerivationStrategy
    
    
Class: sbol:equals

    Annotations: 
        rdfs:comment "Subject and object occupy the same location in space or sequence.",
        rdfs:label "equals"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:finishes

    Annotations: 
        rdfs:comment "Subject starts after object starts; end positions are equal.",
        rdfs:label "finishes"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:inline

    Annotations: 
        rdfs:label "inline"
    
    SubClassOf: 
        sbol:Orientation
    
    
Class: sbol:isDisjointFrom

    Annotations: 
        rdfs:comment "Subject and object do not overlap in space.",
        rdfs:label "isDisjointFrom"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:meets

    Annotations: 
        rdfs:comment "Subject and object are connected at a shared boundary.",
        rdfs:label "meets"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:mergeRoles

    Annotations: 
        rdfs:label "mergeRoles"
    
    SubClassOf: 
        sbol:RoleIntegration
    
    
Class: sbol:one

    Annotations: 
        rdfs:label "one"
    
    SubClassOf: 
        sbol:Cardinality
    
    
Class: sbol:oneOrMore

    Annotations: 
        rdfs:label "OneOrMore"
    
    SubClassOf: 
        sbol:Cardinality
    
    
Class: sbol:oppositeOrientationAs

    Annotations: 
        rdfs:comment "Subject and object have opposite strand orientations.",
        rdfs:label "oppositeOrientationAs"
    
    SubClassOf: 
        sbol:OrientationRestriction
    
    
Class: sbol:overlaps

    Annotations: 
        rdfs:comment "Subject and object overlap but portions of each are outside the other.",
        rdfs:label "overlaps"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:overrideRoles

    Annotations: 
        rdfs:label "overrideRoles"
    
    SubClassOf: 
        sbol:RoleIntegration
    
    
Class: sbol:precedes

    Annotations: 
        rdfs:comment "Start of subject location is less than start of object location.",
        rdfs:label "precedes"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:replaces

    Annotations: 
        rdfs:comment "The definition of subject is to replace the definition of object during design resolution.",
        rdfs:label "replaces"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:reverseComplement

    Annotations: 
        rdfs:label "reverseComplement"
    
    SubClassOf: 
        sbol:Orientation
    
    
Class: sbol:sameOrientationAs

    Annotations: 
        rdfs:comment "Subject and object have the same strand orientation.",
        rdfs:label "sameOrientationAs"
    
    SubClassOf: 
        sbol:OrientationRestriction
    
    
Class: sbol:sample

    Annotations: 
        rdfs:label "sample"
    
    SubClassOf: 
        sbol:CombinatorialDerivationStrategy
    
    
Class: sbol:starts

    Annotations: 
        rdfs:comment "Start positions are equal; subject ends before object ends.",
        rdfs:label "starts"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:strictlyContains

    Annotations: 
        rdfs:comment "Subject entirely contains object without sharing any boundary.",
        rdfs:label "strictlyContains"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:strictlyPrecedes

    Annotations: 
        rdfs:comment "End of subject location is less than start of object location.",
        rdfs:label "strictlyPrecedes"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:verifyIdentical

    Annotations: 
        rdfs:comment "Subject and object must both be SubComponents with the same instanceOf or ExternallyDefined with the same definition.",
        rdfs:label "verifyIdentical"
    
    SubClassOf: 
        sbol:ConstraintRestriction
    
    
Class: sbol:zeroOrMore

    Annotations: 
        rdfs:label "zeroOrMore"
    
    SubClassOf: 
        sbol:Cardinality
    
    
Class: sbol:zeroOrOne

    Annotations: 
        rdfs:label "zeroOrOne"
    
    SubClassOf: 
        sbol:Cardinality
    
    
DisjointClasses: 
    sbol:Attachment,sbol:Collection,sbol:CombinatorialDerivation,sbol:Component,sbol:ExperimentalData,sbol:Implementation,sbol:Model,sbol:SBOLActivity,sbol:SBOLAgent,sbol:SBOLBinaryPrefix,sbol:SBOLCompoundUnit,sbol:SBOLMeasure,sbol:SBOLPlan,sbol:SBOLPrefixedUnit,sbol:SBOLSIPrefix,sbol:SBOLSingularUnit,sbol:SBOLUnitDivision,sbol:SBOLUnitExponentiation,sbol:SBOLUnitMultiplication,sbol:Sequence

DisjointClasses: 
    sbol:ComponentReference,sbol:ExternallyDefined,sbol:LocalSubComponent,sbol:SequenceFeature,sbol:SubComponent

DisjointClasses: 
    sbol:Cut,sbol:EntireSequence,sbol:Range

