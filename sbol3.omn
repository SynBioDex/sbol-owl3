Prefix: identifiers: <https://identifiers.org/>
Prefix: om: <http://www.ontology-of-units-of-measure.org/resource/om-2/>
Prefix: otol: <http://keele.ac.uk/scm/otol#>
Prefix: owl: <http://www.w3.org/2002/07/owl#>
Prefix: prov: <https://www.w3.org/ns/prov#>
Prefix: rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
Prefix: rdfs: <http://www.w3.org/2000/01/rdf-schema#>
Prefix: sbol: <http://sbols.org/v3#>
Prefix: xml: <http://www.w3.org/XML/1998/namespace>
Prefix: xsd: <http://www.w3.org/2001/XMLSchema#>
Prefix: : <http://sbols.org/v3#>



Ontology: <http://sbols.org/v3#>


AnnotationProperty: otol:constantList

    Annotations: 
        rdfs:comment "If true, create an enum list.",
        rdfs:label "Constant list"
    
    
AnnotationProperty: otol:domainEntity

    Annotations: 
        rdfs:comment "If true, indicates that the term corresponds to a domain entity. Software automation tools should create a specific entity.",
        rdfs:label "domainEntity"
    
    
AnnotationProperty: otol:replacementOf

    Annotations: 
        rdfs:comment "If specified, create the entity name according to the value of this property. E.g. for sbol3:SBOLActivity otol:replacementOf prov:Activity, create the entities using the Activity name only.",
        rdfs:label "replacementOf"
    
    
AnnotationProperty: otol:vocabulary

    Annotations: 
        rdfs:comment "If true, an object should be created for the container class.",
        rdfs:label "Vocabulary"
    
    
AnnotationProperty: rdfs:comment

    
AnnotationProperty: rdfs:label

    
Datatype: xsd:dateTime

    
Datatype: xsd:decimal

    
Datatype: xsd:integer

    
Datatype: xsd:string

    
ObjectProperty: om:hasBase

    Annotations: 
        rdfs:comment "The om:hasBase property is REQUIRED and MUST contain a IRI that refers to another om:Unit.",
        rdfs:label "hasBase"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:UnitExponentiation
    
    Range: 
        om:Unit
    
    
ObjectProperty: om:hasDenominator

    Annotations: 
        rdfs:comment "The om:hasDenominator property is REQUIRED and MUST contain a IRI that refers to another om:Unit.",
        rdfs:label "hasDenominator"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:UnitDivision
    
    Range: 
        om:Unit
    
    
ObjectProperty: om:hasNumerator

    Annotations: 
        rdfs:comment "The om:hasNumerator property is REQUIRED and MUST contain a IRI that refers to another om:Unit.",
        rdfs:label "hasNumerator"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:UnitDivision
    
    Range: 
        om:Unit
    
    
ObjectProperty: om:hasPrefix

    Annotations: 
        rdfs:comment "The om:hasPrefix property is REQUIRED and MUST contain a IRI that refers to a om:Prefix.",
        rdfs:label "hasPrefix"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:PrefixedUnit
    
    Range: 
        om:Prefix
    
    
ObjectProperty: om:hasTerm1

    Annotations: 
        rdfs:comment "The om:hasTerm1 property is REQUIRED and MUST contain a IRI that refers to another om:Unit. This om:Unit is the first multiplication term.",
        rdfs:label "hasTerm1"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:UnitMultiplication
    
    Range: 
        om:Unit
    
    
ObjectProperty: om:hasTerm2

    Annotations: 
        rdfs:comment "The om:hasTerm2 property is REQUIRED and MUST contain a IRI that refers to another om:Unit. This om:Unit is the second multiplication term. It is okay if the om:Unit referred to by om:hasTerm1 is the same as that referred to by om:hasTerm2.",
        rdfs:label "hasTerm2"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:UnitMultiplication
    
    Range: 
        om:Unit
    
    
ObjectProperty: om:hasUnit

    Annotations: 
        rdfs:comment "This property can be used in a Measure, SingularUnit or PrefixedUnit. For Measure and PrefixedUnit, the om:hasUnit property is REQUIRED and MUST contain a IRI that refers to a om:Unit. For SingularUnit, the om:hasUnit is OPTIONAL and MAY contain a IRI.",
        rdfs:label "hasUnit"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:Measure or om:PrefixedUnit or om:SingularUnit
    
    Range: 
        om:Unit
    
    
ObjectProperty: owl:topObjectProperty

    
ObjectProperty: prov:agent

    Annotations: 
        rdfs:comment "The prov:agent property is REQUIRED and MUST contain a IRI that refers to an prov:Agent object.",
        rdfs:label "agent"
    
    Characteristics: 
        Functional
    
    Domain: 
        prov:Association
    
    Range: 
        prov:Agent
    
    
ObjectProperty: prov:entity

    Annotations: 
        rdfs:comment "The prov:entity property is REQUIRED and MUST contain a IRI which MAY refer to an Identified object.",
        rdfs:label "entity"
    
    Characteristics: 
        Functional
    
    Domain: 
        prov:Usage
    
    
ObjectProperty: prov:hadPlan

    Annotations: 
        rdfs:comment "The prov:hadPlan property is OPTIONAL and contains a IRI that refers to a prov:Plan.",
        rdfs:label "hadPlan"
    
    Characteristics: 
        Functional
    
    Domain: 
        prov:Association
    
    Range: 
        prov:Plan
    
    
ObjectProperty: prov:hadRole

    Annotations: 
        rdfs:comment "An prov:Usage MAY have one or more prov:hadRole properties, each of type IRI that refers to particular term(s) describing the usage of an prov:Entity referenced by the prov:entity property.",
        rdfs:label "hadRole"
    
    Domain: 
        prov:Association or prov:Usage
    
    
ObjectProperty: prov:qualifiedAssociation

    Annotations: 
        rdfs:comment "An prov:Activity MAY have one or more prov:qualifiedAssociation properties, each of type IRI that refers to an prov:Association object.",
        rdfs:label "qualifiedAssociation"
    
    Domain: 
        prov:Activity
    
    Range: 
        prov:Association
    
    
ObjectProperty: prov:qualifiedUsage

    Annotations: 
        rdfs:comment "An prov:Activity MAY have one or more prov:qualifiedUsage properties, each of type IRI that refers to an prov:Usage object.",
        rdfs:label "qualifiedUsage"
    
    Domain: 
        prov:Activity
    
    Range: 
        prov:Usage
    
    
ObjectProperty: prov:wasDerivedFrom

    Annotations: 
        rdfs:comment "An Identified object MAY have zero or more prov:wasDerivedFrom properties, each of type IRI. This property is defined by the PROV-O ontology and is located in the https://www.w3.org/ns/prov# namespace",
        rdfs:label "wasDerivedFrom"
    
    Domain: 
        sbol:Identified
    
    Range: 
        owl:Thing
    
    
ObjectProperty: prov:wasGeneratedBy

    Annotations: 
        rdfs:comment "An Identified object MAY have zero or more prov:wasGeneratedBy properties, each of type IRI.",
        rdfs:label "wasGeneratedBy"
    
    Domain: 
        sbol:Identified
    
    Range: 
        sbol:SBOLActivity
    
    
ObjectProperty: prov:wasInformedBy

    Annotations: 
        rdfs:comment "An prov:Activity MAY have one or more prov:wasInformedBy properties, each of type IRI that refers to another prov:Activity object.",
        rdfs:label "wasInformedBy"
    
    Domain: 
        prov:Activity
    
    Range: 
        prov:Activity
    
    
ObjectProperty: rdf:type

    
ObjectProperty: sbol:built

    Annotations: 
        rdfs:comment "The built property is OPTIONAL and MAY contain a IRI that MUST refer to a Component. This Component is intended to describe the actual physical structure and/or functional behavior of the Implementation.",
        rdfs:label "built"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Implementation
    
    Range: 
        sbol:Component
    
    
ObjectProperty: sbol:cardinality

    Annotations: 
        rdfs:comment "The cardinality property is REQUIRED and has type of IRI. This property specifies how many Feature objects SHOULD be derived from the template Feature during the derivation of a new Component.",
        rdfs:label "cardinality"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:VariableFeature
    
    Range: 
        sbol:one or sbol:oneOrMore or sbol:zeroOrMore or sbol:zeroOrOne
    
    
ObjectProperty: sbol:comprises

    Annotations: 
        rdfs:comment "The comprises property can be used to express parent-child compositional relationships as a custom approach if needed.",
        rdfs:label "comprises"
    
    Characteristics: 
        Transitive
    
    
ObjectProperty: sbol:definition

    Annotations: 
        rdfs:comment "The definition property is REQUIRED and is of type IRI that links to a canonical definition external to SBOL.",
        rdfs:label "definition"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:ExternallyDefined
    
    
ObjectProperty: sbol:directlyComprises

    Annotations: 
        rdfs:comment "Subclass of comprises that is used to express direct parent-child compositional relationships.",
        rdfs:label "directlyComprises"
    
    SubPropertyOf: 
        sbol:comprises
    
    
ObjectProperty: sbol:encoding

    Annotations: 
        rdfs:comment "The encoding property has a data type of IRI, and is OPTIONAL unless elements is set, in which case it is REQUIRED.",
        rdfs:label "encoding"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Sequence
    
    
ObjectProperty: sbol:format

    Annotations: 
        rdfs:comment "The format property is OPTIONAL and MAY contain a IRI that specifies the format of the attached file. It is RECOMMENDED that this IRI refer to a term from the EMBRACE Data and Methods (EDAM) ontology",
        rdfs:label "format"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Attachment
    
    
ObjectProperty: sbol:framework

    Annotations: 
        rdfs:comment "The framework property is REQUIRED and MUST contain a IRI that specifies the framework in which the model is implemented. It is RECOMMENDED this IRI refer to a term from the modeling framework branch of the SBO when possible.",
        rdfs:label "framework"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Model
    
    
ObjectProperty: sbol:hasAttachment

    Annotations: 
        rdfs:comment "A TopLevel object can have zero or more hasAttachment properties, each of type IRI specifying an Attachment object.",
        rdfs:label "hasAttachment"
    
    Domain: 
        sbol:TopLevel
    
    Range: 
        sbol:Attachment
    
    
ObjectProperty: sbol:hasConstraint

    Annotations: 
        rdfs:comment "A Component MAY have any number of hasConstraint properties, each of type IRI, that MUST reference a Constraint object.",
        rdfs:label "hasConstraint"
    
    SubPropertyOf: 
        sbol:directlyComprises
    
    Domain: 
        sbol:Component
    
    Range: 
        sbol:Constraint
    
    
ObjectProperty: sbol:hasFeature

    Annotations: 
        rdfs:comment "A Component MAY have any number of hasFeature properties, each of type IRI that MUST reference a Feature object",
        rdfs:label "hasFeature"
    
    SubPropertyOf: 
        sbol:directlyComprises
    
    Domain: 
        sbol:Component
    
    Range: 
        sbol:Feature
    
    
ObjectProperty: sbol:hasInteraction

    Annotations: 
        rdfs:comment "A Component MAY have any number of hasInteraction properties, each of type IRI, that MUST reference an Interaction object.",
        rdfs:label "hasInteraction"
    
    SubPropertyOf: 
        sbol:directlyComprises
    
    Domain: 
        sbol:Component
    
    Range: 
        sbol:Interaction
    
    
ObjectProperty: sbol:hasInterface

    Annotations: 
        rdfs:comment "A Component MAY have zero or one hasInterface property of type IRI that MUST reference an Interface object.",
        rdfs:label "hasInterface"
    
    SubPropertyOf: 
        sbol:directlyComprises
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Component
    
    Range: 
        sbol:Interface
    
    
ObjectProperty: sbol:hasLocation

    Annotations: 
        rdfs:comment "A SubComponent MAY have any number of hasLocation properties, each of type IRI, that MUST refer to Location objects that indicates the location of the Sequence from the instanceOf Component in a Sequence of the parent Component. A LocalSubComponent MAY have any number of hasLocation properties, each of type IRI, that MUST refer to Location objects. In SequenceFeature, the hasLocation is REQUIRED and contains one or more IRIs, which MUST refer to Location objects.",
        rdfs:label "hasLocation"
    
    SubPropertyOf: 
        sbol:directlyComprises
    
    Domain: 
        sbol:LocalSubComponent or sbol:SequenceFeature or sbol:SubComponent
    
    Range: 
        sbol:Location
    
    
ObjectProperty: sbol:hasMeasure

    Annotations: 
        rdfs:label "hasMeasure"
    
    SubPropertyOf: 
        sbol:directlyComprises
    
    Domain: 
        sbol:Identified
    
    Range: 
        sbol:SBOLMeasure,
        om:Measure
    
    
ObjectProperty: sbol:hasModel

    Annotations: 
        rdfs:comment "A Component MAY have any number of hasModel properties, each of type IRI, that MUST reference a Model object.",
        rdfs:label "hasModel"
    
    Domain: 
        sbol:Component
    
    Range: 
        sbol:Model
    
    
ObjectProperty: sbol:hasNamespace

    Annotations: 
        rdfs:comment "A TopLevel object MUST have precisely one hasNamespace property, which contains a URL that defines the namespace portion of URLs for this object and any child objects.",
        rdfs:label "hasNamespace"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:TopLevel
    
    
ObjectProperty: sbol:hasParticipation

    Annotations: 
        rdfs:comment "An Interaction MAY have any number of hasParticipation properties, each of type IRI, that MUST reference a Participation object, each of which identifies the role that its referenced Feature plays in the Interaction.",
        rdfs:label "hasParticipation"
    
    SubPropertyOf: 
        sbol:directlyComprises
    
    Domain: 
        sbol:Interaction
    
    Range: 
        sbol:Participation
    
    
ObjectProperty: sbol:hasSequence

    Annotations: 
        rdfs:comment "This property can be used in a Component or Location. A Component MAY have any number of hasSequence properties, each of type IRI, that MUST reference a Sequence object. In a Location, the hasSequence property is REQUIRED and MUST contain the IRI of a Sequence object.",
        rdfs:label "hasSequence"
    
    Domain: 
        sbol:Component or sbol:Location
    
    Range: 
        sbol:Sequence
    
    
ObjectProperty: sbol:hasVariableFeature

    Annotations: 
        rdfs:comment "A CombinatorialDerivation object can have zero or more hasVariableFeature properties, each of type IRI, specifying a VariableFeature. The set of hasVariableFeature properties MUST NOT contain two or more VariableFeature objects that refer to the same template.",
        rdfs:label "hasVariableFeature"
    
    SubPropertyOf: 
        sbol:directlyComprises
    
    Domain: 
        sbol:CombinatorialDerivation
    
    Range: 
        sbol:VariableFeature
    
    
ObjectProperty: sbol:higherOrderParticipant

    Annotations: 
        rdfs:comment "The higherOrderParticipant property indicates an Interaction object that plays the designated role in its parent Interaction object. Precisely one value MUST be specified for precisely one of participant or higherOrderParticipant.",
        rdfs:label "higherOrderParticipant"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Participation
    
    Range: 
        sbol:Interaction
    
    
ObjectProperty: sbol:inChildOf

    Annotations: 
        rdfs:label "inChildOf"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:ComponentReference
    
    Range: 
        sbol:SubComponent
    
    
ObjectProperty: sbol:input

    Annotations: 
        rdfs:comment "An Interface MAY have any number of input properties, each of type IRI, that MUST reference a Feature object in the same Component.",
        rdfs:label "input"
    
    Domain: 
        sbol:Interface
    
    Range: 
        sbol:Feature
    
    
ObjectProperty: sbol:instanceOf

    Annotations: 
        rdfs:comment "The instanceOf property is a REQUIRED IRI that refers to the Component providing the definition for this SubComponent.",
        rdfs:label "instanceOf"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:SubComponent
    
    Range: 
        sbol:Component
    
    
ObjectProperty: sbol:language

    Annotations: 
        rdfs:comment "The language property is REQUIRED and MUST contain a IRI that specifies the language in which the model is implemented. It is RECOMMENDED that this IRI refer to a term from the EMBRACE Data and Methods (EDAM) ontology.",
        rdfs:label "language"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Model
    
    
ObjectProperty: sbol:member

    Annotations: 
        rdfs:comment "A Collection object can have zero or more member properties, each of type IRI specifying a TopLevel object.",
        rdfs:label "member"
    
    Domain: 
        sbol:Collection
    
    Range: 
        sbol:TopLevel
    
    
ObjectProperty: sbol:nondirectional

    Annotations: 
        rdfs:comment "An Interface MAY have any number of nondirectional properties, each of type IRI, that MUST reference a Feature object in the same Component.",
        rdfs:label "nondirectional"
    
    Domain: 
        sbol:Interface
    
    Range: 
        sbol:Feature
    
    
ObjectProperty: sbol:object

    Annotations: 
        rdfs:comment "The object property is REQUIRED and MUST contain a IRI that refers to a Feature contained by the same parent Component that contains the Constraint. This Feature MUST NOT be the same Feature that the Constraint refers to via its subject property.",
        rdfs:label "object"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Constraint
    
    Range: 
        sbol:Feature
    
    
ObjectProperty: sbol:orientation

    Annotations: 
        rdfs:comment "The orientation property is OPTIONAL and has a data type of IRI.",
        rdfs:label "orientation"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Feature or sbol:Location
    
    Range: 
        sbol:Orientation
    
    
ObjectProperty: sbol:output

    Annotations: 
        rdfs:comment "An Interface MAY have any number of output properties, each of type IRI, that MUST reference a Feature object in the same Component.",
        rdfs:label "output"
    
    Domain: 
        sbol:Interface
    
    Range: 
        sbol:Feature
    
    
ObjectProperty: sbol:participant

    Annotations: 
        rdfs:comment "The participant property indicates a Feature object that plays the designated role in its parent Interaction object. Precisely one value MUST be specified for precisely one of participant or higherOrderParticipant.",
        rdfs:label "participant"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Participation
    
    Range: 
        sbol:Feature
    
    
ObjectProperty: sbol:refersTo

    Annotations: 
        rdfs:comment "The refersTo property is a REQUIRED IRI that refers to a Feature.",
        rdfs:label "refersTo"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:ComponentReference
    
    Range: 
        sbol:Feature
    
    
ObjectProperty: sbol:restriction

    Annotations: 
        rdfs:comment "The restriction property is REQUIRED and has a data type of IRI. This property MUST indicate the type of restriction on the locations, orientations, or identities of the subject and object Feature objects in relation to each other.",
        rdfs:label "restriction"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Constraint
    
    
ObjectProperty: sbol:role

    Annotations: 
        rdfs:comment "This property can be used in a Component, Feature or Participation. A Component MAY have any number of role properties, each of type IRI, that MUST identify terms from ontologies that are consistent with the type property of the Component. Each Feature can have zero or more role property IRIs describing the purpose or potential function of this Feature in the context of its parent Component. A Participation is REQUIRED to have one or more role properties, each of type IRI, that describes the behavior of a Participation (and by extension its referenced Feature) in the context of its parent Interaction.",
        rdfs:label "role"
    
    Domain: 
        sbol:Component or sbol:Feature or sbol:Participation
    
    
ObjectProperty: sbol:roleIntegration

    Annotations: 
        rdfs:comment "A roleIntegration specifies the relationship between a SubComponent instance's own set of role properties and the set of role properties on the included Component.",
        rdfs:label "roleIntegration"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:SubComponent
    
    
ObjectProperty: sbol:source

    Annotations: 
        rdfs:comment "The source property is REQUIRED and MUST contain a IRI reference to the source file.",
        rdfs:label "source"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Attachment or sbol:Model
    
    
ObjectProperty: sbol:sourceLocation

    Annotations: 
        rdfs:comment "The sourceLocation property allows for only a portion of a Component's Sequence to be included, rather than its entirety.",
        rdfs:label "sourceLocation"
    
    SubPropertyOf: 
        sbol:directlyComprises
    
    Domain: 
        sbol:SubComponent
    
    Range: 
        sbol:Location
    
    
ObjectProperty: sbol:strategy

    Annotations: 
        rdfs:comment "The strategy property is OPTIONAL and has a data type of IRI.",
        rdfs:label "strategy"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:CombinatorialDerivation
    
    Range: 
        sbol:enumerate or sbol:sample
    
    
ObjectProperty: sbol:subject

    Annotations: 
        rdfs:comment "The subject property is REQUIRED and MUST contain a IRI that refers to a Feature contained by the same parent Component that contains the Constraint.",
        rdfs:label "subject"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Constraint
    
    Range: 
        sbol:Feature
    
    
ObjectProperty: sbol:template

    Annotations: 
        rdfs:comment "The template property is REQUIRED and MUST contain a IRI that refers to a Component. ",
        rdfs:label "template"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:CombinatorialDerivation
    
    Range: 
        sbol:Component
    
    
ObjectProperty: sbol:type

    Annotations: 
        rdfs:comment "A Component MUST have one or more type properties, each of type IRI specifying the category of biochemical or physical entity (for example DNA, protein, or simple chemical) that a Component object abstracts for the purpose of engineering design",
        rdfs:label "type"
    
    Domain: 
        sbol:Component or sbol:ExternallyDefined or sbol:Interaction or sbol:LocalSubComponent or sbol:SBOLActivity or sbol:SBOLMeasure
    
    
ObjectProperty: sbol:variable

    Annotations: 
        rdfs:comment "The variable property is REQUIRED and MUST contain a IRI that refers to a template Feature in the template Component referred to by this VariableFeature's parent CombinatorialDerivation",
        rdfs:label "variable"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:VariableFeature
    
    Range: 
        sbol:Feature
    
    
ObjectProperty: sbol:variant

    Annotations: 
        rdfs:comment "A VariableFeature object can have zero or more variant properties, each of type IRI, specifying a Component object. This property specifies individual Component objects to serve as options when deriving a new Feature for the variable Feature from the template.",
        rdfs:label "variant"
    
    Domain: 
        sbol:VariableFeature
    
    Range: 
        sbol:Component
    
    
ObjectProperty: sbol:variantCollection

    Annotations: 
        rdfs:comment "A VariableFeature object can have zero or more variantCollection properties, each of type IRI, specifying a Collection object. Such a Collection MUST NOT contain any objects besides Component objects or Collection objects that themselves contain only Component or Collection objects. This property enables the specification of existing groups of Component objects to serve as options.",
        rdfs:label "variantCollection"
    
    Domain: 
        sbol:VariableFeature
    
    Range: 
        sbol:Collection
    
    
ObjectProperty: sbol:variantDerivation

    Annotations: 
        rdfs:comment "A VariableFeature object can have zero or more variantDerivation properties, each of type IRI, specifying a CombinatorialDerivation object. This property enables the specification of Component objects derived in accordance with another CombinatorialDerivation to serve as options when deriving a new Feature for the variable Feature from the template.",
        rdfs:label "variantDerivation"
    
    Domain: 
        sbol:VariableFeature
    
    Range: 
        sbol:CombinatorialDerivation
    
    
ObjectProperty: sbol:variantMeasure

    Annotations: 
        rdfs:comment "A VariableFeature object can have zero or more variantMeasure properties, each of type IRI, specifying a om:Measure object. This property specifies numerical values that are options to be applied to the variable Feature from the template when deriving a new Component.",
        rdfs:label "variantMeasure"
    
    Domain: 
        sbol:VariableFeature
    
    Range: 
        om:Measure
    
    
DataProperty: om:alternativeLabel

    Annotations: 
        rdfs:comment "This property can be used in a Unit or Prefix. The om:alternativeLabel property is OPTIONAL and MAY contain a set of Strings. This property can be used to specify alternative common names other than that specified using om:label property.",
        rdfs:label "alternativeLabel"
    
    Domain: 
        om:Prefix or om:Unit
    
    Range: 
        xsd:string
    
    
DataProperty: om:alternativeSymbol

    Annotations: 
        rdfs:comment "This property can be used in a Unit or Prefix. The om:alternativeSymbol property is OPTIONAL and MAY contain a set of Strings. This property can be used to specify alternative abbreviations other than that specified using the om:symbol property",
        rdfs:label "alternativeSymbol"
    
    Domain: 
        om:Prefix or om:Unit
    
    Range: 
        xsd:string
    
    
DataProperty: om:hasExponent

    Annotations: 
        rdfs:comment "The om:hasExponent property is REQUIRED and MUST contain an xsd:integer.",
        rdfs:label "hasExponent"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:UnitExponentiation
    
    Range: 
        xsd:integer
    
    
DataProperty: om:hasFactor

    Annotations: 
        rdfs:comment "This property can be used in a SingularUnit or Prefix. For SingularUnit, the om:hasFactor property is OPTIONAL and MAY contain a xsd:float. If the om:hasFactor property of a om:SingularUnit is non-empty, then its om:hasUnit property SHOULD also be non-empty. For Prefix, The om:hasFactor property is REQUIRED and MUST contain an xsd:float.",
        rdfs:label "hasFactor"
    
    Domain: 
        om:Prefix or om:SingularUnit
    
    Range: 
        xsd:decimal
    
    
DataProperty: om:hasNumericalValue

    Annotations: 
        rdfs:comment "The om:hasNumericalValue property is REQUIRED and MUST contain a single xsd:float.",
        rdfs:label "hasNumericalValue"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:Measure
    
    Range: 
        xsd:decimal
    
    
DataProperty: om:longComment

    Annotations: 
        rdfs:comment "This property can be used in a Unit or Prefix. The om:longcomment property is OPTIONAL and MAY contain a String. This String is a long description of the unit of measure and SHOULD be longer than any String contained by the om:comment property.",
        rdfs:label "longComment"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:Prefix or om:Unit
    
    Range: 
        xsd:string
    
    
DataProperty: om:symbol

    Annotations: 
        rdfs:comment "This property can be used in a Unit or Prefix. The om:symbol property is REQUIRED and MUST contain a String. This String is commonly used to abbreviate the name of the unit of measure or prefix.",
        rdfs:label "symbol"
    
    Characteristics: 
        Functional
    
    Domain: 
        om:Prefix or om:Unit
    
    Range: 
        xsd:string
    
    
DataProperty: prov:endedAtTime

    Annotations: 
        rdfs:comment "The prov:endedAtTime property is OPTIONAL and contains a DateTime value, indicating when the activity ended.",
        rdfs:label "endedAtTime"
    
    Characteristics: 
        Functional
    
    Domain: 
        prov:Activity
    
    Range: 
        xsd:dateTime
    
    
DataProperty: prov:startedAtTime

    Annotations: 
        rdfs:comment "The prov:startedAtTime property is OPTIONAL and contains a DateTime value, indicating when the activity started. If this property is present, then the prov:endedAtTime property is REQUIRED.",
        rdfs:label "startedAtTime"
    
    Characteristics: 
        Functional
    
    Domain: 
        prov:Activity
    
    Range: 
        xsd:dateTime
    
    
DataProperty: rdfs:label

    
DataProperty: sbol:at

    Annotations: 
        rdfs:comment "The at property is REQUIRED and MUST contain an Integer value greater than or equal to zero. The region specified by the Cut is between the position specified by this property and the position that immediately follows it. When the at property is equal to zero, the specified region is immediately before the first discrete position or character in the elements String of a Sequence.",
        rdfs:label "at"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Cut
    
    Range: 
        xsd:integer[>= 0]
    
    
DataProperty: sbol:description

    Annotations: 
        rdfs:comment "The description property is OPTIONAL and has a data type of String. This property is intended to contain a more thorough text description of an Identified object.",
        rdfs:label "description"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Identified
    
    Range: 
        xsd:string
    
    
DataProperty: sbol:displayId

    Annotations: 
        rdfs:comment "The displayId property is an OPTIONAL identifier with a data type of String. This property is intended to be an intermediate between a IRI and the name property that is machine-readable, but more human-readable than the full IRI of an object",
        rdfs:label "displayId"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Identified
    
    Range: 
        xsd:string
    
    
DataProperty: sbol:elements

    Annotations: 
        rdfs:comment "The elements property is an OPTIONAL String of characters that represents the constituents of a biological or chemical molecule.",
        rdfs:label "elements"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Sequence
    
    Range: 
        xsd:string
    
    
DataProperty: sbol:end

    Annotations: 
        rdfs:comment "The end property specifies the inclusive ending position of the Range. This property is REQUIRED and MUST contain an Integer value greater than zero. In addition, this Integer value MUST be greater than or equal to that of the start property.",
        rdfs:label "end"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Range
    
    Range: 
        xsd:integer[>= 1]
    
    
DataProperty: sbol:hash

    Annotations: 
        rdfs:comment "The hash property is OPTIONAL and MAY contain a hash value for the file contents represented as a hexadecimal digest.",
        rdfs:label "hash"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Attachment
    
    Range: 
        xsd:string
    
    
DataProperty: sbol:hashAlgorithm

    Annotations: 
        rdfs:comment "The hashAlgorithm property is OPTIONAL and MAY contain the name of the hash algorithm used to generate the value of the hash property. The value of this property SHOULD be a hash name string from the IANA Named Information Hash Algorithm Registry, of which sha3-256 is currently RECOMMENDED. If the hash property is set, then hashAlgorithm MUST be set as well.",
        rdfs:label "hashAlgorithm"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Attachment
    
    Range: 
        xsd:string
    
    
DataProperty: sbol:name

    Annotations: 
        rdfs:comment "The name property is OPTIONAL and has a data type of String. This property is intended to be displayed to a human when visualizing an Identified object.",
        rdfs:label "name"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Identified
    
    Range: 
        xsd:string
    
    
DataProperty: sbol:order

    Annotations: 
        rdfs:comment "The order property is OPTIONAL and has a data type of Integer. If there are multiple Location objects associated with a Feature, the order property is used to specify the order (in increasing value) in which the specified Locations are to be joined to form the sequence of the Feature.",
        rdfs:label "order"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Location
    
    Range: 
        xsd:integer[>= 1]
    
    
DataProperty: sbol:size

    Annotations: 
        rdfs:comment "The size property is OPTIONAL and MAY contain a long indicating the file size in bytes.",
        rdfs:label "size"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Attachment
    
    Range: 
        xsd:integer[>= 0]
    
    
DataProperty: sbol:start

    Annotations: 
        rdfs:comment "The start property specifies the inclusive starting position of the Range. This property is REQUIRED and MUST contain an Integer value greater than zero.",
        rdfs:label "start"
    
    Characteristics: 
        Functional
    
    Domain: 
        sbol:Range
    
    Range: 
        xsd:integer[>= 1]
    
    
Class: identifiers:CHEBI:35224

    Annotations: 
        rdfs:comment "A small molecule which increases (activator) or decreases (inhibitor) the activity of an (allosteric) enzyme by binding to the enzyme at the regulatory site (which is different from the substrate-binding catalytic site).",
        rdfs:label "effector"
    
    SubClassOf: 
        identifiers:CHEBI:50906
    
    
Class: identifiers:CHEBI:50906

    Annotations: 
        rdfs:comment "A role is particular behaviour which a material entity may exhibit.",
        rdfs:label "material entity role"
    
    SubClassOf: 
        owl:Thing
    
    
Class: identifiers:GO:0003674

    Annotations: 
        rdfs:comment "A molecular process that can be carried out by the action of a single macromolecular machine, usually via direct physical interactions with other molecular entities. Function in this sense denotes an action, or activity, that a gene product (or a complex) performs.",
        rdfs:label "molecular_function"
    
    SubClassOf: 
        owl:Thing
    
    
Class: identifiers:GO:0003700

    Annotations: 
        rdfs:comment "A transcription regulator activity that modulates transcription of gene sets via selective and non-covalent binding to a specific double-stranded genomic DNA sequence (sometimes referred to as a motif) within a cis-regulatory region. Regulatory regions include promoters (proximal and distal) and enhancers. Genes are transcriptional units, and include bacterial operons.",
        rdfs:label "DNA-binding transcription factor activity"
    
    SubClassOf: 
        identifiers:GO:0003674
    
    
Class: identifiers:SBO:0000000

    Annotations: 
        rdfs:comment "Representation of an entity used in a systems biology knowledge reconstruction, such as a model, pathway, network.",
        rdfs:label "systems biology representation"
    
    SubClassOf: 
        owl:Thing
    
    
Class: identifiers:SBO:0000003

    Annotations: 
        rdfs:comment "The function of a physical or conceptual entity, that is its role, in the execution of an event or process.",
        rdfs:label "participant role"
    
    SubClassOf: 
        identifiers:SBO:0000000
    
    
Class: identifiers:SBO:0000004

    Annotations: 
        rdfs:comment "Set of assumptions that underlay a mathematical description.",
        rdfs:label "modelling framework"
    
    SubClassOf: 
        identifiers:SBO:0000000
    
    
Class: identifiers:SBO:0000010

    Annotations: 
        rdfs:comment "Substance consumed by a chemical reaction. Reactants react with each other to form the products of a chemical reaction. In a chemical equation the Reactants are the elements or compounds on the left hand side of the reaction equation. A reactant can be consumed and produced by the same reaction, its global quantity remaining unchanged.",
        rdfs:label "reactant"
    
    SubClassOf: 
        identifiers:SBO:0000003
    
    
Class: identifiers:SBO:0000011

    Annotations: 
        rdfs:comment "Substance that is produced in a reaction. In a chemical equation the Products are the elements or compounds on the right hand side of the reaction equation. A product can be produced and consumed by the same reaction, its global quantity remaining unchanged.",
        rdfs:label "product"
    
    SubClassOf: 
        identifiers:SBO:0000003
    
    
Class: identifiers:SBO:0000019

    Annotations: 
        rdfs:comment "Substance that changes the velocity of a process without itself being consumed or transformed by the reaction.",
        rdfs:label "modifier"
    
    SubClassOf: 
        identifiers:SBO:0000003
    
    
Class: identifiers:SBO:0000020

    Annotations: 
        rdfs:comment "Substance that decreases the probability of a chemical reaction without itself being consumed or transformed by the reaction.",
        rdfs:label "inhibitor"
    
    SubClassOf: 
        identifiers:SBO:0000019
    
    
Class: identifiers:SBO:0000062

    Annotations: 
        rdfs:comment "Modelling approach where the quantities of participants are considered continuous, and represented by real values. The associated simulation methods make use of differential equations.",
        rdfs:label "continuous framework"
    
    SubClassOf: 
        identifiers:SBO:0000004
    
    
Class: identifiers:SBO:0000063

    Annotations: 
        rdfs:comment "Modelling approach where the quantities of participants are considered discrete, and represented by integer values. The associated simulation methods can be deterministic or stochastic.",
        rdfs:label "discrete framework"
    
    SubClassOf: 
        identifiers:SBO:0000004
    
    
Class: identifiers:SBO:0000167

    Annotations: 
        rdfs:comment "An event involving physical entities that results in modification of structure, location, or free energy.",
        rdfs:label "biochemical or transport reaction"
    
    SubClassOf: 
        identifiers:SBO:0000231
    
    
Class: identifiers:SBO:0000168

    Annotations: 
        rdfs:comment "Synonym: regulation",
        rdfs:label "control"
    
    SubClassOf: 
        identifiers:SBO:0000231
    
    
Class: identifiers:SBO:0000169

    Annotations: 
        rdfs:comment "Negative modulation of the execution of a process.",
        rdfs:label "inhibition"
    
    SubClassOf: 
        identifiers:SBO:0000168
    
    
Class: identifiers:SBO:0000170

    Annotations: 
        rdfs:comment "Positive modulation of the execution of a process.",
        rdfs:label "stimulation"
    
    SubClassOf: 
        identifiers:SBO:0000168
    
    
Class: identifiers:SBO:0000176

    Annotations: 
        rdfs:comment "An event involving one or more chemical entities that modifies the electrochemical structure of at least one of the participants.",
        rdfs:label "biochemical reaction"
    
    SubClassOf: 
        identifiers:SBO:0000167
    
    
Class: identifiers:SBO:0000177

    Annotations: 
        rdfs:comment "Synonym: association",
        rdfs:label "non-covalent binding"
    
    SubClassOf: 
        identifiers:SBO:0000176
    
    
Class: identifiers:SBO:0000179

    Annotations: 
        rdfs:comment "Complete disappearance of a physical entity.",
        rdfs:label "degradation"
    
    SubClassOf: 
        identifiers:SBO:0000176
    
    
Class: identifiers:SBO:0000231

    Annotations: 
        rdfs:comment "Representation of an entity that manifests, unfolds or develops through time, such as a discrete event, or a mutual or reciprocal action or influence that happens between participating physical entities, and/or other occurring entities.",
        rdfs:label "occurring entity representation"
    
    SubClassOf: 
        identifiers:SBO:0000000
    
    
Class: identifiers:SBO:0000234

    Annotations: 
        rdfs:comment "Modelling approach, pioneered by Rene Thomas and Stuart Kaufman, where the evolution of a system is described by the transitions between discrete activity states of 'genes' that control each other.",
        rdfs:label "logical framework"
    
    SubClassOf: 
        identifiers:SBO:0000004
    
    
Class: identifiers:SBO:0000236

    Annotations: 
        rdfs:comment "Synonym: new synonym",
        rdfs:label "physical entity representation"
    
    SubClassOf: 
        identifiers:SBO:0000000
    
    
Class: identifiers:SBO:0000241

    Annotations: 
        rdfs:comment "A real thing, defined by its properties or the actions it performs, rather than it physico-chemical structure.",
        rdfs:label "functional entity"
    
    SubClassOf: 
        identifiers:SBO:0000236
    
    
Class: identifiers:SBO:0000247

    Annotations: 
        rdfs:comment "Simple, non-repetitive chemical entity.",
        rdfs:label "simple chemical"
    
    SubClassOf: 
        identifiers:SBO:0000236
    
    
Class: identifiers:SBO:0000250

    Annotations: 
        rdfs:comment "Synonym: RNA",
        rdfs:label "ribonucleic acid"
    
    SubClassOf: 
        identifiers:SBO:0000236
    
    
Class: identifiers:SBO:0000251

    Annotations: 
        rdfs:comment "Synonym: DNA",
        rdfs:label "deoxyribonucleic acid"
    
    SubClassOf: 
        identifiers:SBO:0000236
    
    
Class: identifiers:SBO:0000252

    Annotations: 
        rdfs:comment "Naturally occurring macromolecule formed by the repetition of amino-acid residues linked by peptidic bonds. A polypeptide chain is synthesized by the ribosome.",
        rdfs:label "polypeptide chain"
    
    SubClassOf: 
        identifiers:SBO:0000236
    
    
Class: identifiers:SBO:0000253

    Annotations: 
        rdfs:comment "Entity composed of several independant components that are not linked by covalent bonds.",
        rdfs:label "non-covalent complex"
    
    SubClassOf: 
        identifiers:SBO:0000236
    
    
Class: identifiers:SBO:0000289

    Annotations: 
        rdfs:comment "Logical or physical subset of the event space that contains pools, that is sets of participants considered identical when it comes to the event they are involved into. A compartment can have any number of dimensions, including 0, and be of any size including null.",
        rdfs:label "functional compartment"
    
    SubClassOf: 
        identifiers:SBO:0000003
    
    
Class: identifiers:SBO:0000459

    Annotations: 
        rdfs:comment "Synonym: activator",
        rdfs:label "stimulator"
    
    SubClassOf: 
        identifiers:SBO:0000019
    
    
Class: identifiers:SBO:0000589

    Annotations: 
        rdfs:comment "A composite biochemical process through which a gene sequence is fully converted into mature gene products. These gene products may include RNA species as well as proteins, and the process encompasses all intermediate steps required to generate the active form of the gene product.",
        rdfs:label "genetic production"
    
    SubClassOf: 
        identifiers:SBO:0000231
    
    
Class: identifiers:SBO:0000598

    Annotations: 
        rdfs:comment "A region of DNA to which various transcription factors and RNA polymerase must bind in order to initiate transcription for a gene.",
        rdfs:label "promoter"
    
    SubClassOf: 
        identifiers:SBO:0000003
    
    
Class: identifiers:SBO:0000642

    Annotations: 
        rdfs:comment "Conceptual or material entity that is the object of an inhibition process, and is acted upon by an inhibitor.",
        rdfs:label "inhibited"
    
    SubClassOf: 
        identifiers:SBO:0000003
    
    
Class: identifiers:SBO:0000643

    Annotations: 
        rdfs:comment "Conceptual or material entity that is the object of a stimulation process, and is acted upon by a stimulator.",
        rdfs:label "stimulated"
    
    SubClassOf: 
        identifiers:SBO:0000003
    
    
Class: identifiers:SBO:0000644

    Annotations: 
        rdfs:comment "Conceptual or material entity that is the object of a modification process, and is acted upon by a modifier.",
        rdfs:label "modified"
    
    SubClassOf: 
        identifiers:SBO:0000003
    
    
Class: identifiers:SBO:0000645

    Annotations: 
        rdfs:comment "An entity that acts as the starting material for genetic production (http://identifiers.org/biomodels.sbo/SBO:0000589).",
        rdfs:label "template"
    
    SubClassOf: 
        identifiers:SBO:0000003
    
    
Class: identifiers:SBO:0000681

    Annotations: 
        rdfs:comment "Modeling approach which combines multiple canonical modeling frameworks. For example, a hybrid model could consider both continuous (represented by real values) and discrete (represented by integers) participants. Hybrid models are executed with hybrid simulation algorithms. For example, a hybrid continuous-discrete model may be simulation using a combination of stochastic simulation and ordinary differential equations.",
        rdfs:label "hybrid framework"
    
    SubClassOf: 
        identifiers:SBO:0000004
    
    
Class: identifiers:SBO:0000693

    Annotations: 
        rdfs:comment "Modelling approach which captures bounds on the possible behavior of a system, which may be further reduced using an objective function.",
        rdfs:label "constraint-based framework"
    
    SubClassOf: 
        identifiers:SBO:0000004
    
    
Class: identifiers:SO:0000057

    Annotations: 
        rdfs:comment "Moved to transcriptional_cis_regulatory_region (SO:0001055) from gene_group_regulatory_region (SO:0000752) on 11 Feb 2021 when SO:0000752 was merged into SO:0001055. See GitHub Issue #529. A regulatory element of an operon to which activators or repressors bind thereby effecting translation of genes in that operon.",
        rdfs:label "operator"
    
    SubClassOf: 
        identifiers:SO:0000110
    
    
Class: identifiers:SO:0000110

    Annotations: 
        rdfs:comment "Any extent of continuous biological sequence.",
        rdfs:label "sequence_feature"
    
    SubClassOf: 
        owl:Thing
    
    
Class: identifiers:SO:0000139

    Annotations: 
        rdfs:comment "Region in mRNA where ribosome assembles.",
        rdfs:label "ribosome_entry_site"
    
    SubClassOf: 
        identifiers:SO:0000110
    
    
Class: identifiers:SO:0000141

    Annotations: 
        rdfs:comment "Moved from transcription_regulatory_region (SO:0001679) to transcriptional_cis_regulatory_region (SO:0001055) by Dave Sant on Feb 11, 2021 when transcription_regulatory_region was merged into transcriptional_cis_regulatory_region to be consistent with GO and reduce redundancy as part of the GREEKC consortium. See GitHub Issue #527. The sequence of DNA located either at the end of the transcript that causes RNA polymerase to terminate transcription.",
        rdfs:label "terminator"
    
    SubClassOf: 
        identifiers:SO:0000110
    
    
Class: identifiers:SO:0000167

    Annotations: 
        rdfs:comment "This term is mapped to MGED. Do not obsolete without consulting MGED ontology. The region on a DNA molecule involved in RNA polymerase binding to initiate transcription. Moved from is_a: SO:0001055 transcriptional_cis_regulatory_region as per request from GREEKC initiative in August 2020. Merged with RNA_polymerase_promoter (SO:0001203) Aug 2020. Moved up one level from is_a CRM (SO:0000727) to is_a transcriptional_cis_regulatory_region (SO:0001055) as part of the GREEKC work January 2021. Pascale Gaudet from Gene Ontology pointed out that CRM can be located upstream of the promoter and therefore cannot include the promoter. A regulatory_region composed of the TSS(s) and binding sites for TF_complexes of the core transcription machinery. A region (DNA) to which RNA polymerase binds, to begin transcription.",
        rdfs:label "promoter"
    
    SubClassOf: 
        identifiers:SO:0000110
    
    
Class: identifiers:SO:0000234

    Annotations: 
        rdfs:comment "An mRNA does not contain introns as it is a processed_transcript. The equivalent kind of primary_transcript is protein_coding_primary_transcript (SO:0000120) which may contain introns. This term is mapped to MGED. Do not obsolete without consulting MGED ontology. Messenger RNA is the intermediate molecule between DNA and protein. It includes UTR and coding sequences. It does not contain introns.",
        rdfs:label "mRNA"
    
    SubClassOf: 
        identifiers:SO:0000110
    
    
Class: identifiers:SO:0000316

    Annotations: 
        rdfs:comment "A contiguous sequence which begins with, and includes, a start codon and ends with, and includes, a stop codon.",
        rdfs:label "CDS"
    
    SubClassOf: 
        identifiers:SO:0000110
    
    
Class: identifiers:SO:0000400

    Annotations: 
        rdfs:comment "An attribute describes a quality of sequence.",
        rdfs:label "sequence_attribute"
    
    SubClassOf: 
        owl:Thing
    
    
Class: identifiers:SO:0000704

    Annotations: 
        rdfs:comment "This term is mapped to MGED. Do not obsolete without consulting MGED ontology. A gene may be considered as a unit of inheritance. A region (or regions) that includes all of the sequence elements necessary to encode a functional transcript. A gene may include regulatory regions, transcribed regions and/or other functional sequence regions.",
        rdfs:label "gene"
    
    SubClassOf: 
        identifiers:SO:0000110
    
    
Class: identifiers:SO:0000804

    Annotations: 
        rdfs:comment "A region that is engineered.",
        rdfs:label "engineered_region"
    
    SubClassOf: 
        identifiers:SO:0000110
    
    
Class: identifiers:SO:0000984

    Annotations: 
        rdfs:comment "Attributes added to describe the different kinds of replicon. SO workshop, September 2006. When a nucleotide polymer has only one strand.",
        rdfs:label "single"
    
    SubClassOf: 
        identifiers:SO:0000400
    
    
Class: identifiers:SO:0000985

    Annotations: 
        rdfs:comment "Attributes added to describe the different kinds of replicon. SO workshop, September 2006. When a nucleotide polymer has two strands that are reverse-complement to one another and pair together.",
        rdfs:label "double"
    
    SubClassOf: 
        identifiers:SO:0000400
    
    
Class: identifiers:SO:0000987

    Annotations: 
        rdfs:comment "Attributes added to describe the different kinds of replicon. SO workshop, September 2006. A quality of a nucleotide polymer that has a 3'-terminal residue and a 5'-terminal residue.",
        rdfs:label "linear"
    
    SubClassOf: 
        identifiers:SO:0000400
    
    
Class: identifiers:SO:0000988

    Annotations: 
        rdfs:comment "Attributes added to describe the different kinds of replicon. SO workshop, September 2006. A quality of a nucleotide polymer that has no terminal nucleotide residues.",
        rdfs:label "circular"
    
    SubClassOf: 
        identifiers:SO:0000400
    
    
Class: identifiers:SO:0001030

    Annotations: 
        rdfs:comment "Forward is an attribute of the feature, where the feature is in the 5' to 3' direction.",
        rdfs:label "forward"
    
    SubClassOf: 
        identifiers:SO:0000400
    
    
Class: identifiers:SO:0001031

    Annotations: 
        rdfs:comment "Reverse is an attribute of the feature, where the feature is in the 3' to 5' direction. Again could be applied to primer.",
        rdfs:label "reverse"
    
    SubClassOf: 
        identifiers:SO:0000400
    
    
Class: identifiers:edam:format_1196

    Annotations: 
        rdfs:comment "Chemical structure specified in Simplified Molecular Input Line Entry System (SMILES) line notation.",
        rdfs:label "SMILES"
    
    SubClassOf: 
        identifiers:edam:format_1915
    
    
Class: identifiers:edam:format_1197

    Annotations: 
        rdfs:comment "Chemical structure specified in IUPAC International Chemical Identifier (InChI) line notation.",
        rdfs:label "InChI"
    
    SubClassOf: 
        identifiers:edam:format_1915
    
    
Class: identifiers:edam:format_1207

