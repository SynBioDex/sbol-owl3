    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasSequence</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO: CHECK DOMAIN: A Component MAY have any number of hasSequence properties, each of type IRI, that MUST reference a Sequence object</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#hash">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
