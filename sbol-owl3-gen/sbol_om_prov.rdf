    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The subject and object are connected at a shared boundary.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#ModelFramework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
