    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">input</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Interface MAY have any number of input properties, each of type IRI, that MUST reference a Feature object in the same Component.</rdfs:comment>
  </rdf:Description>
