  <rdf:Description rdf:about="http://sbols.org/v3#differentFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differentFrom</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The subject and object, after tracing through any layers of ComponentReference, MUST NOT both refer to SubComponent objects with the same instanceOf value or both refer to ExternallyDefined objects with the same definition. Example: two fluorescent reporters must be different.</rdfs:comment>
  </rdf:Description>
