  <rdf:Description rdf:about="http://sbols.org/v3#at">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://sbols.org/v3#Cut"/>
    <rdfs:range rdf:nodeID="Ne8f401e8096141e1bec10a9ef18584c8"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">at</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The at property is REQUIRED and MUST contain an Integer value greater than or equal to zero. The region specified by the Cut is between the position specified by this property and the position that immediately follows it. When the at property is equal to zero, the specified region is immediately before the first discrete position or character in the elements String of a Sequence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#meets">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
