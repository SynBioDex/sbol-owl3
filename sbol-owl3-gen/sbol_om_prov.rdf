  <rdf:Description rdf:about="http://sbols.org/v3#verifyIdentical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verifyIdentical</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The subject and object, after tracing through any layers of ComponentReference, MUST both refer to SubComponent objects with the same instanceOf value or both refer to ExternallyDefined objects with the same definition. Example: a promoter included via two different subsystems must be the identical.</rdfs:comment>
  </rdf:Description>
