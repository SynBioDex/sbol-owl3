  <rdf:Description rdf:about="http://sbols.org/v3#enumerate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#CombinatorialDerivationStrategy"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enumerate</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Derivation SHOULD produce all possible Component objects specified by the CombinatorialDerivation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#hasLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
    <rdfs:domain rdf:nodeID="Ned9fc926a5fc46ebb54a0ddbba20cff2"/>
    <rdfs:range rdf:resource="http://sbols.org/v3#Location"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasLocation</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A SubComponent MAY have any number of hasLocation properties, each of type IRI, that MUST refer to Location objects that indicates the location of the Sequence from the instanceOf Component in a Sequence of the parent Component. A LocalSubComponent MAY have any number of hasLocation properties, each of type IRI, that MUST refer to Location objects. In SequenceFeature, the hasLocation is REQUIRED and contains one or more IRIs, which MUST refer to Location objects.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#CombinatorialDerivation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#TopLevel"/>
    <rdfs:subClassOf rdf:nodeID="N7c5a2ad60996423abf83387e7b888b5b"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CombinatorialDerivation</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The purpose of the CombinatorialDerivation class is to specify combinatorial biological designs without having to specify every possible design variant.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N186e9fa6e65444908927d7dfad10a430">
