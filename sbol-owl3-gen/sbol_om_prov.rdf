    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hash</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The hash property is OPTIONAL and MAY contain a hash value for the file contents represented as a hexadecimal digest.</rdfs:comment>
  </rdf:Description>
