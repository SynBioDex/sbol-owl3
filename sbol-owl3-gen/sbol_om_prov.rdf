    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At least one Feature in the derived Component SHOULD have a prov:wasDerivedFrom property that refers to the template Feature.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#starts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
