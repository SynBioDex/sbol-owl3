    <rdfs:subClassOf rdf:resource="https://www.w3.org/ns/prov#Association"/>
    <otol:replacementOf rdf:resource="https://www.w3.org/ns/prov#Association"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBOL Association</rdfs:label>
