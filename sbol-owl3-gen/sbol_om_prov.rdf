    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#RoleIntegration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#SBOLTerm"/>
    <owl:equivalentClass rdf:nodeID="N3bcec01c659f4240a3aae231f479dce2"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RoleIntegration</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A roleIntegration specifies the relationship between a SubComponent instance's own set of role properties and the set of role properties on the included Component.</rdfs:comment>
    <otol:constantList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:constantList>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#SubComponent">
