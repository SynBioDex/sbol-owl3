    <owl:equivalentClass rdf:nodeID="N802a009c28d847b4909f34a4dec97864"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ModelFramework</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO: CHECK: The framework property is REQUIRED and MUST contain a IRI that specifies the framework in which the model is implemented.</rdfs:comment>
    <otol:constantList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:constantList>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#DNAComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Component"/>
    <owl:equivalentClass rdf:nodeID="N022aa3b8f1d8433185043f88d0b4e887"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA Component</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a DNA component, with the type of SBO:DNA, the role of DNARole. It restricts instances to have the sequences with the correct DNA encoding.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#BiochemicalReactionInteraction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Interaction"/>
    <owl:equivalentClass rdf:nodeID="N23411e8609794487899b3fccdcb5634c"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BiochemicalReactionInteraction</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a biochemical reaction interaction, with the type of SBO:biochemical_reaction, that involves zero or more modifier, modified, product, and reactant participations.</rdfs:comment>
    <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
  </rdf:Description>
