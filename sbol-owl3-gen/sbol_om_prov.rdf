  </rdf:Description>
  <rdf:Description rdf:about="http://sbols.org/v3#output">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://sbols.org/v3#Interface"/>
    <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
