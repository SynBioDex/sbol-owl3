<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.ontology-of-units-of-measure.org/resource/om-2/"
         xmlns="http://www.ontology-of-units-of-measure.org/resource/om-2/">

<owl:Ontology rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2"/>

<owl:ObjectProperty rdf:about="hasUnit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="Measure"/>
        <rdf:Description rdf:about="SingularUnit"/>
        <rdf:Description rdf:about="PrefixedUnit"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="Unit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasUnit</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="hasTerm1">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="UnitMultiplication"/>
  <rdfs:range rdf:resource="Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="hasTerm2">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="UnitMultiplication"/>
  <rdfs:range rdf:resource="Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="hasNumerator">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="UnitDivision"/>
  <rdfs:range rdf:resource="Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="hasDenominator">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="UnitDivision"/>
  <rdfs:range rdf:resource="Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="hasBase">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="UnitExponentiation"/>
  <rdfs:range rdf:resource="Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="hasPrefix">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="PrefixedUnit"/>
  <rdfs:range rdf:resource="Prefix"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="hasNumericalValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="Measure"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasNumericalValue</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="symbol">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="Unit"/>
        <rdf:Description rdf:about="Prefix"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symbol</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="alternativeSymbol">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="Unit"/>
        <rdf:Description rdf:about="Prefix"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alternativeSymbol</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="alternativeLabel">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="Unit"/>
        <rdf:Description rdf:about="Prefix"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alternativeSymbol</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="longComment">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="Unit"/>
        <rdf:Description rdf:about="Prefix"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">longcomment</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="hasFactor">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="SingularUnit"/>
        <rdf:Description rdf:about="Prefix"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasFactor</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="hasExponent">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="UnitExponentiation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="Measure">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasNumericalValue"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasUnit"/>
      <owl:someValuesFrom rdf:resource="Unit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="Unit">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="symbol"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unit</rdfs:label>
</owl:Class>

<owl:Class rdf:about="SingularUnit">
  <rdfs:subClassOf rdf:resource="Unit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SingularUnit</rdfs:label>
</owl:Class>

<owl:Class rdf:about="CompoundUnit">
  <rdfs:subClassOf rdf:resource="Unit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CompoundUnit</rdfs:label>
</owl:Class>

<owl:Class rdf:about="PrefixedUnit">
  <rdfs:subClassOf rdf:resource="Unit"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasUnit"/>
      <owl:someValuesFrom rdf:resource="Unit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasPrefix"/>
      <owl:someValuesFrom rdf:resource="Prefix"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PrefixedUnit</rdfs:label>
</owl:Class>

<owl:Class rdf:about="UnitMultiplication">
  <rdfs:subClassOf rdf:resource="Unit"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasTerm1"/>
      <owl:someValuesFrom rdf:resource="Unit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasTerm2"/>
      <owl:someValuesFrom rdf:resource="Unit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnitMultiplication</rdfs:label>
</owl:Class>

<owl:Class rdf:about="UnitDivision">
  <rdfs:subClassOf rdf:resource="Unit"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasNumerator"/>
      <owl:someValuesFrom rdf:resource="Unit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasDenominator"/>
      <owl:someValuesFrom rdf:resource="Unit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnitDivision</rdfs:label>
</owl:Class>

<owl:Class rdf:about="UnitExponentiation">
  <rdfs:subClassOf rdf:resource="Unit"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasBase"/>
      <owl:someValuesFrom rdf:resource="Unit"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasExponent"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnitExponentiation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="Prefix">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="symbol"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasFactor"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prefix</rdfs:label>
</owl:Class>

<owl:Class rdf:about="SIPrefix">
  <rdfs:subClassOf rdf:resource="Prefix"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SIPrefix</rdfs:label>
</owl:Class>

<owl:Class rdf:about="BinaryPrefix">
  <rdfs:subClassOf rdf:resource="Prefix"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BinaryPrefix</rdfs:label>
</owl:Class>


</rdf:RDF>
