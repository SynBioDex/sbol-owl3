                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Participation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#role"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SBO:0000643"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Participation"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:label>StimulatedParticipation</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#StimulationInteraction -->

    <owl:Class rdf:about="http://sbols.org/v3#StimulationInteraction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Interaction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#participant"/>
                        <owl:someValuesFrom rdf:resource="http://sbols.org/v3#StimulatedParticipation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#participant"/>
                        <owl:someValuesFrom rdf:resource="http://sbols.org/v3#StimulatorParticipation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#type"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SBO:0000170"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Interaction"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:label>StimulationInteraction</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#StimulatorParticipation -->

    <owl:Class rdf:about="http://sbols.org/v3#StimulatorParticipation">
        <owl:equivalentClass>
