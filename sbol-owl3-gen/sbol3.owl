    </owl:Class>
    


    <!-- http://sbols.org/v3#TopLevel -->

    <owl:Class rdf:about="http://sbols.org/v3#TopLevel">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Identified"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sbols.org/v3#hasNamespace"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>TopLevel</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#TopologyRestriction -->

    <owl:Class rdf:about="http://sbols.org/v3#TopologyRestriction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#contains"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#covers"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#equals"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#isDisjointFrom"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#meets"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#overlaps"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#strictlyContains"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <otol:constantList>true</otol:constantList>
        <rdfs:label>TopologyRestriction</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#TranscriptionFactorProteinComponent -->

    <owl:Class rdf:about="http://sbols.org/v3#TranscriptionFactorProteinComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#ProteinComponent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#role"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/GO:0003700"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ProteinComponent"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:label>Transcription Factor Protein Component</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#VariableFeature -->

    <owl:Class rdf:about="http://sbols.org/v3#VariableFeature">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Identified"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sbols.org/v3#cardinality"/>
                <owl:someValuesFrom rdf:resource="http://sbols.org/v3#Cardinality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sbols.org/v3#variable"/>
                <owl:someValuesFrom rdf:resource="http://sbols.org/v3#Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:label>VariableFeature</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#contains -->

    <owl:Class rdf:about="http://sbols.org/v3#contains">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject contains object; they might or might not share a boundary.</rdfs:comment>
        <rdfs:label>contains</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#covers -->

    <owl:Class rdf:about="http://sbols.org/v3#covers">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject covers object.</rdfs:comment>
        <rdfs:label>covers</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#differentFrom -->

    <owl:Class rdf:about="http://sbols.org/v3#differentFrom">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject and object must NOT refer to the same Component/definition.</rdfs:comment>
        <rdfs:label>differentFrom</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#enumerate -->

    <owl:Class rdf:about="http://sbols.org/v3#enumerate">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#CombinatorialDerivationStrategy"/>
        <rdfs:label>enumerate</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#equals -->

    <owl:Class rdf:about="http://sbols.org/v3#equals">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject and object occupy the same location in space or sequence.</rdfs:comment>
        <rdfs:label>equals</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#finishes -->

    <owl:Class rdf:about="http://sbols.org/v3#finishes">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject starts after object starts; end positions are equal.</rdfs:comment>
        <rdfs:label>finishes</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#inline -->

    <owl:Class rdf:about="http://sbols.org/v3#inline">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Orientation"/>
        <rdfs:label>inline</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#isDisjointFrom -->

    <owl:Class rdf:about="http://sbols.org/v3#isDisjointFrom">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject and object do not overlap in space.</rdfs:comment>
        <rdfs:label>isDisjointFrom</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#meets -->

    <owl:Class rdf:about="http://sbols.org/v3#meets">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject and object are connected at a shared boundary.</rdfs:comment>
        <rdfs:label>meets</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#mergeRoles -->

    <owl:Class rdf:about="http://sbols.org/v3#mergeRoles">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#RoleIntegration"/>
        <rdfs:label>mergeRoles</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#one -->

    <owl:Class rdf:about="http://sbols.org/v3#one">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Cardinality"/>
        <rdfs:label>one</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#oneOrMore -->

    <owl:Class rdf:about="http://sbols.org/v3#oneOrMore">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Cardinality"/>
        <rdfs:label>OneOrMore</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#oppositeOrientationAs -->

    <owl:Class rdf:about="http://sbols.org/v3#oppositeOrientationAs">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#OrientationRestriction"/>
        <rdfs:comment>Subject and object have opposite strand orientations.</rdfs:comment>
        <rdfs:label>oppositeOrientationAs</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#overlaps -->

    <owl:Class rdf:about="http://sbols.org/v3#overlaps">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject and object overlap but portions of each are outside the other.</rdfs:comment>
        <rdfs:label>overlaps</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#overrideRoles -->

    <owl:Class rdf:about="http://sbols.org/v3#overrideRoles">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#RoleIntegration"/>
        <rdfs:label>overrideRoles</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#precedes -->

    <owl:Class rdf:about="http://sbols.org/v3#precedes">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Start of subject location is less than start of object location.</rdfs:comment>
        <rdfs:label>precedes</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#replaces -->

    <owl:Class rdf:about="http://sbols.org/v3#replaces">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>The definition of subject is to replace the definition of object during design resolution.</rdfs:comment>
        <rdfs:label>replaces</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#reverseComplement -->

    <owl:Class rdf:about="http://sbols.org/v3#reverseComplement">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Orientation"/>
        <rdfs:label>reverseComplement</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#sameOrientationAs -->

    <owl:Class rdf:about="http://sbols.org/v3#sameOrientationAs">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#OrientationRestriction"/>
        <rdfs:comment>Subject and object have the same strand orientation.</rdfs:comment>
        <rdfs:label>sameOrientationAs</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#sample -->

    <owl:Class rdf:about="http://sbols.org/v3#sample">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#CombinatorialDerivationStrategy"/>
        <rdfs:label>sample</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#starts -->

    <owl:Class rdf:about="http://sbols.org/v3#starts">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Start positions are equal; subject ends before object ends.</rdfs:comment>
        <rdfs:label>starts</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#strictlyContains -->

    <owl:Class rdf:about="http://sbols.org/v3#strictlyContains">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject entirely contains object without sharing any boundary.</rdfs:comment>
        <rdfs:label>strictlyContains</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#strictlyPrecedes -->

    <owl:Class rdf:about="http://sbols.org/v3#strictlyPrecedes">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>End of subject location is less than start of object location.</rdfs:comment>
        <rdfs:label>strictlyPrecedes</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#verifyIdentical -->

    <owl:Class rdf:about="http://sbols.org/v3#verifyIdentical">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#ConstraintRestriction"/>
        <rdfs:comment>Subject and object must both be SubComponents with the same instanceOf or ExternallyDefined with the same definition.</rdfs:comment>
        <rdfs:label>verifyIdentical</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#zeroOrMore -->

    <owl:Class rdf:about="http://sbols.org/v3#zeroOrMore">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Cardinality"/>
        <rdfs:label>zeroOrMore</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#zeroOrOne -->

    <owl:Class rdf:about="http://sbols.org/v3#zeroOrOne">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Cardinality"/>
        <rdfs:label>zeroOrOne</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/BinaryPrefix -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/BinaryPrefix">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Prefix"/>
        <rdfs:label>BinaryPrefix</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/CompoundUnit -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/CompoundUnit">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:label>CompoundUnit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Measure -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit"/>
                <owl:someValuesFrom rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Measure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Prefix -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Prefix">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasFactor"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/symbol"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Prefix</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/PrefixedUnit -->

    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/PrefixedUnit">
