<?xml version="1.0"?>
<rdf:RDF xmlns="http://sbols.org/v3#"
     xml:base="http://sbols.org/v3"
     xmlns:om="http://www.ontology-of-units-of-measure.org/resource/om-2/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:otol="http://keele.ac.uk/scm/otol#"
     xmlns:prov="https://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sbol="http://sbols.org/v3#"
     xmlns:identifiers="https://identifiers.org/">
    <owl:Ontology rdf:about="http://sbols.org/v3#"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://keele.ac.uk/scm/otol#constantList -->

    <owl:AnnotationProperty rdf:about="http://keele.ac.uk/scm/otol#constantList">
        <rdfs:comment>If true, create an enum list.</rdfs:comment>
        <rdfs:label>Constant list</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://keele.ac.uk/scm/otol#domainEntity -->

    <owl:AnnotationProperty rdf:about="http://keele.ac.uk/scm/otol#domainEntity">
        <rdfs:comment>If true, indicates that the term corresponds to a domain entity. Software automation tools should create a specific entity.</rdfs:comment>
        <rdfs:label>domainEntity</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://keele.ac.uk/scm/otol#replacementOf -->

    <owl:AnnotationProperty rdf:about="http://keele.ac.uk/scm/otol#replacementOf">
        <rdfs:comment>If specified, create the entity name according to the value of this property. E.g. for sbol3:SBOLActivity otol:replacementOf prov:Activity, create the entities using the Activity name only.</rdfs:comment>
        <rdfs:label>replacementOf</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://keele.ac.uk/scm/otol#vocabulary -->

    <owl:AnnotationProperty rdf:about="http://keele.ac.uk/scm/otol#vocabulary">
        <rdfs:comment>If true, an object should be created for the container class.</rdfs:comment>
        <rdfs:label>Vocabulary</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://sbols.org/v3#built -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#built">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Implementation"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Component"/>
        <rdfs:label>built</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#cardinality -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#cardinality">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#VariableFeature"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#one"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#oneOrMore"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#zeroOrMore"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#zeroOrOne"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>cardinality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#comprises -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#comprises">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>comprises</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#definition -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#definition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#ExternallyDefined"/>
        <rdfs:label>definition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#directlyComprises -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#directlyComprises">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#comprises"/>
        <rdfs:label>directlyComprises</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#encoding -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#encoding">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Sequence"/>
        <rdfs:label>encoding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#format -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#format">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Attachment"/>
        <rdfs:label>format</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#framework -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#framework">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Model"/>
        <rdfs:label>framework</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasAttachment -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasAttachment">
        <rdfs:domain rdf:resource="http://sbols.org/v3#TopLevel"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Attachment"/>
        <rdfs:label>hasAttachment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasConstraint -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasConstraint">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Component"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Constraint"/>
        <rdfs:label>hasConstraint</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasFeature -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasFeature">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Component"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:label>hasFeature</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasInteraction -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasInteraction">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Component"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Interaction"/>
        <rdfs:label>hasInteraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasInterface -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasInterface">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Component"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Interface"/>
        <rdfs:label>hasInterface</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasLocation -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasLocation">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#LocalSubComponent"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#SequenceFeature"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#SubComponent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://sbols.org/v3#Location"/>
        <rdfs:label>hasLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasMeasure -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasMeasure">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Identified"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:label>hasMeasure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasModel -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasModel">
        <rdfs:domain rdf:resource="http://sbols.org/v3#Component"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Model"/>
        <rdfs:label>hasModel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasNamespace -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasNamespace">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#TopLevel"/>
        <rdfs:label>hasNamespace</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasParticipation -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasParticipation">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Interaction"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Participation"/>
        <rdfs:label>hasParticipation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasSequence -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasSequence">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Component"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#Location"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://sbols.org/v3#Sequence"/>
        <rdfs:label>hasSequence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#hasVariableFeature -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#hasVariableFeature">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#CombinatorialDerivation"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#VariableFeature"/>
        <rdfs:label>hasVariableFeature</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#higherOrderParticipant -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#higherOrderParticipant">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Participation"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Interaction"/>
        <rdfs:label>higherOrderParticipant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#inChildOf -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#inChildOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#ComponentReference"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#SubComponent"/>
        <rdfs:label>inChildOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#input -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#input">
        <rdfs:domain rdf:resource="http://sbols.org/v3#Interface"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:label>input</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#instanceOf -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#instanceOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#SubComponent"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Component"/>
        <rdfs:label>instanceOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#language -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#language">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Model"/>
        <rdfs:label>language</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#member -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#member">
        <rdfs:domain rdf:resource="http://sbols.org/v3#Collection"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#TopLevel"/>
        <rdfs:label>member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#nondirectional -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#nondirectional">
        <rdfs:domain rdf:resource="http://sbols.org/v3#Interface"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:label>nondirectional</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#object -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#object">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Constraint"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:label>object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#orientation -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#orientation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Feature"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#Location"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://sbols.org/v3#Orientation"/>
        <rdfs:label>orientation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#output -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#output">
        <rdfs:domain rdf:resource="http://sbols.org/v3#Interface"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:label>output</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#participant -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#participant">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Participation"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:label>participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#refersTo -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#refersTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#ComponentReference"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:label>refersTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#restriction -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#restriction">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Constraint"/>
        <rdfs:label>restriction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#role -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#role">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Component"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#Feature"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#Participation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label>role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#roleIntegration -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#roleIntegration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#SubComponent"/>
        <rdfs:label>roleIntegration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#source -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#source">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Attachment"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#Model"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label>source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#sourceLocation -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#sourceLocation">
        <rdfs:subPropertyOf rdf:resource="http://sbols.org/v3#directlyComprises"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#SubComponent"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Location"/>
        <rdfs:label>sourceLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#strategy -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#strategy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#CombinatorialDerivation"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#enumerate"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#sample"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#subject -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#subject">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#Constraint"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:label>subject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#template -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#template">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#CombinatorialDerivation"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Component"/>
        <rdfs:label>template</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#type -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#type">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Component"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#ExternallyDefined"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#Interaction"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#LocalSubComponent"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#SBOLActivity"/>
                    <rdf:Description rdf:about="http://sbols.org/v3#SBOLMeasure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label>type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#variable -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#variable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbols.org/v3#VariableFeature"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Feature"/>
        <rdfs:label>variable</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#variant -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#variant">
        <rdfs:domain rdf:resource="http://sbols.org/v3#VariableFeature"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Component"/>
        <rdfs:label>variant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#variantCollection -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#variantCollection">
        <rdfs:domain rdf:resource="http://sbols.org/v3#VariableFeature"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#Collection"/>
        <rdfs:label>variantCollection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#variantDerivation -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#variantDerivation">
        <rdfs:domain rdf:resource="http://sbols.org/v3#VariableFeature"/>
        <rdfs:range rdf:resource="http://sbols.org/v3#CombinatorialDerivation"/>
        <rdfs:label>variantDerivation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://sbols.org/v3#variantMeasure -->

    <owl:ObjectProperty rdf:about="http://sbols.org/v3#variantMeasure">
        <rdfs:domain rdf:resource="http://sbols.org/v3#VariableFeature"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:label>variantMeasure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/hasBase -->

