    <!-- http://sbols.org/v3#Attachment -->

    <owl:Class rdf:about="http://sbols.org/v3#Attachment">
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#TopLevel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sbols.org/v3#source"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:label>Attachment</rdfs:label>
    </owl:Class>
    


    <!-- http://sbols.org/v3#BiochemicalReactionInteraction -->

    <owl:Class rdf:about="http://sbols.org/v3#BiochemicalReactionInteraction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbols.org/v3#Interaction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#type"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SBO:0000176"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#participant"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://sbols.org/v3#ModifiedParticipation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#participant"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://sbols.org/v3#ModifierParticipation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#participant"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://sbols.org/v3#ProductParticipation"/>
                    </owl:Restriction>
                    <owl:Restriction>
