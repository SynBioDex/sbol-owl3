                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbols.org/v3#role"/>
                        <owl:someValuesFrom rdf:resource="https://identifiers.org/SBO:0000459"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://sbols.org/v3#Participation"/>
        <otol:domainEntity>true</otol:domainEntity>
        <rdfs:label>StimulatorParticipation</rdfs:label>
    </owl:Class>
    


