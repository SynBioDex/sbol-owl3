<owl:Class rdf:about="https://identifiers.org/CHEBI:50906">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Material entity role</rdfs:label>
