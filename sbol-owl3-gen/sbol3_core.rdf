<owl:Class rdf:about="#SBOLSIPrefix">
  <rdfs:subClassOf rdf:resource="#SBOLPrefix"/>
  <otol:replacementOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/SIPrefix"/>
  <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/SIPrefix"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBOLSIPrefix</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A wrapper class to enable the use of OM SIPrefixes in SBOL. This class allows adding custom SBOL relationships.</rdfs:comment>
  <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
</owl:Class>

<owl:Class rdf:about="#SBOLBinaryPrefix">
  <rdfs:subClassOf rdf:resource="#SBOLPrefix"/>
  <otol:replacementOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/BinaryPrefix"/>
  <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/BinaryPrefix"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBOLBinaryPrefix</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A wrapper class to enable the use of OM BinaryPrefixes in SBOL. This class allows adding custom SBOL relationships.</rdfs:comment>
  <otol:domainEntity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</otol:domainEntity>
</owl:Class>

