AnnotationAssertion(rdfs:comment sbol:SimpleChemicalComponent "Represents a simple chemical component, with the type of SBO:simple_chemical, the role of SmallMoleculeRole. It restricts instances to have the sequences with the correct chemical encoding.")
AnnotationAssertion(rdfs:label sbol:SimpleChemicalComponent "Simple Chemical Component")
EquivalentClasses(sbol:SimpleChemicalComponent ObjectIntersectionOf(sbol:Component ObjectSomeValuesFrom(sbol:role sbol:SmallMoleculeRole) ObjectSomeValuesFrom(sbol:type identifiers:SBO:0000247) ObjectAllValuesFrom(sbol:hasSequence ObjectUnionOf(sbol:InChISequence sbol:SMILESSequence))))
