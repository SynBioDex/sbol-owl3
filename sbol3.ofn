# Class: sbol:SequentialRestriction (SequentialRestriction)

AnnotationAssertion(otol:constantList sbol:SequentialRestriction "true")
AnnotationAssertion(rdfs:comment sbol:SequentialRestriction "Sequential restrictions are a subset of the ConstraintRestriction class that are used to express relative, sequence-based positions of pairs of Features within a template Component. The value of a SequentialRestriction must be one of the following: precedes, strictlyPrecedes, meets, overlaps, contains, strictlyContains, equals, starts, or finishes.")
AnnotationAssertion(rdfs:label sbol:SequentialRestriction "SequentialRestriction")
EquivalentClasses(sbol:SequentialRestriction ObjectUnionOf(sbol:contains sbol:equals sbol:finishes sbol:meets sbol:overlaps sbol:precedes sbol:starts sbol:strictlyContains sbol:strictlyPrecedes))
SubClassOf(sbol:SequentialRestriction sbol:ConstraintRestriction)

