AnnotationAssertion(otol:constantList sbol:OrientationRestriction "true")
AnnotationAssertion(rdfs:comment sbol:OrientationRestriction "Orientation restrictions are a subset of the ConstraintRestriction class that are used to express orientation relationships between pairs of Features within a template Component. The value of an OrientationRestriction must be one of the following: sameOrientationAs or oppositeOrientationAs.")
AnnotationAssertion(rdfs:label sbol:OrientationRestriction "OrientationRestriction")
EquivalentClasses(sbol:OrientationRestriction ObjectUnionOf(sbol:oppositeOrientationAs sbol:sameOrientationAs))
SubClassOf(sbol:OrientationRestriction sbol:ConstraintRestriction)

