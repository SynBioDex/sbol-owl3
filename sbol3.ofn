EquivalentClasses(sbol:TerminatorDNAComponent ObjectIntersectionOf(sbol:DNAComponent ObjectSomeValuesFrom(sbol:role identifiers:SO:0000141)))
SubClassOf(sbol:TerminatorDNAComponent sbol:DNAComponent)

# Class: sbol:TopLevel (TopLevel)

AnnotationAssertion(rdfs:comment sbol:TopLevel "TopLevel is an abstract class that is extended by any Identified class that can be found at the top level of an SBOL document or file.")
AnnotationAssertion(rdfs:label sbol:TopLevel "TopLevel")
SubClassOf(sbol:TopLevel sbol:Identified)
SubClassOf(sbol:TopLevel ObjectSomeValuesFrom(sbol:hasNamespace owl:Thing))

# Class: sbol:TopologyRestriction (TopologyRestriction)

AnnotationAssertion(otol:constantList sbol:TopologyRestriction "true")
AnnotationAssertion(rdfs:comment sbol:TopologyRestriction "Topology restrictions are a subset of the ConstraintRestriction class that are used to express topological relationships between pairs of Features within a template Component. The value of a TopologyRestriction must be one of the following: contains, strictlyContains, equals, covers, overlaps, meets, or isDisjointFrom.")
AnnotationAssertion(rdfs:label sbol:TopologyRestriction "TopologyRestriction")
EquivalentClasses(sbol:TopologyRestriction ObjectUnionOf(sbol:contains sbol:covers sbol:equals sbol:isDisjointFrom sbol:meets sbol:overlaps sbol:strictlyContains))
SubClassOf(sbol:TopologyRestriction sbol:ConstraintRestriction)

# Class: sbol:TranscriptionFactorProteinComponent (Transcription Factor Protein Component)

AnnotationAssertion(otol:domainEntity sbol:TranscriptionFactorProteinComponent "true")
AnnotationAssertion(rdfs:comment sbol:TranscriptionFactorProteinComponent "Represents a transcription factor protein component, with the role of GO:DNA-binding transcription factor activity.")
AnnotationAssertion(rdfs:label sbol:TranscriptionFactorProteinComponent "Transcription Factor Protein Component")
EquivalentClasses(sbol:TranscriptionFactorProteinComponent ObjectIntersectionOf(sbol:ProteinComponent ObjectSomeValuesFrom(sbol:role identifiers:GO:0003700)))
SubClassOf(sbol:TranscriptionFactorProteinComponent sbol:ProteinComponent)

# Class: sbol:VariableFeature (VariableFeature)

AnnotationAssertion(otol:domainEntity sbol:VariableFeature "true")
AnnotationAssertion(rdfs:comment sbol:VariableFeature "VariableFeature class specifies a variable and set of values that will replace one of the Feature objects in the template of a CombinatorialDerivation. The variable is specified by the variable property, and the set of values is defined by the union of Component objects referred to by the variant, variantCollection, and variantDerivation properties.")
AnnotationAssertion(rdfs:label sbol:VariableFeature "VariableFeature")
SubClassOf(sbol:VariableFeature sbol:Identified)
SubClassOf(sbol:VariableFeature ObjectSomeValuesFrom(sbol:cardinality sbol:Cardinality))
SubClassOf(sbol:VariableFeature ObjectSomeValuesFrom(sbol:variable sbol:Feature))

# Class: sbol:contains (contains)

AnnotationAssertion(rdfs:comment sbol:contains "The subject contains the object and they might or might not share a boundary.")
AnnotationAssertion(rdfs:label sbol:contains "contains")
SubClassOf(sbol:contains sbol:ConstraintRestriction)

# Class: sbol:covers (covers)

AnnotationAssertion(rdfs:comment sbol:covers "The subject contains the object but also shares a boundary.")
AnnotationAssertion(rdfs:label sbol:covers "covers")
SubClassOf(sbol:covers sbol:ConstraintRestriction)

# Class: sbol:differentFrom (differentFrom)

AnnotationAssertion(rdfs:comment sbol:differentFrom "The subject and object, after tracing through any layers of ComponentReference, MUST NOT both refer to SubComponent objects with the same instanceOf value or both refer to ExternallyDefined objects with the same definition. Example: two fluorescent reporters must be different.")
AnnotationAssertion(rdfs:label sbol:differentFrom "differentFrom")
SubClassOf(sbol:differentFrom sbol:ConstraintRestriction)

# Class: sbol:enumerate (enumerate)

AnnotationAssertion(rdfs:comment sbol:enumerate "Enumerate is a strategy for deriving new Components from a template Component. The enumerate strategy specifies that a new Component should be derived for every possible combination of values for the variable specified by the VariableFeature objects in the template Component.")
AnnotationAssertion(rdfs:label sbol:enumerate "enumerate")
SubClassOf(sbol:enumerate sbol:CombinatorialDerivationStrategy)

# Class: sbol:equals (equals)

AnnotationAssertion(rdfs:comment sbol:equals "The subject and object occupy the same location in space.")
AnnotationAssertion(rdfs:label sbol:equals "equals")
SubClassOf(sbol:equals sbol:ConstraintRestriction)

# Class: sbol:finishes (finishes)

AnnotationAssertion(rdfs:comment sbol:finishes "The start of the location for subject is after the start of the location for object and the end of the location for subject is equal to the end of the location for object.")
AnnotationAssertion(rdfs:label sbol:finishes "finishes")
SubClassOf(sbol:finishes sbol:ConstraintRestriction)

# Class: sbol:inline (inline)

AnnotationAssertion(rdfs:comment sbol:inline "Inline is an attribute of the feature, where the feature is in the 5' to 3' direction.")
AnnotationAssertion(rdfs:label sbol:inline "inline")
SubClassOf(sbol:inline sbol:Orientation)

# Class: sbol:isDisjointFrom (isDisjointFrom)

AnnotationAssertion(rdfs:comment sbol:isDisjointFrom "The subject and object do not overlap in space.")
AnnotationAssertion(rdfs:label sbol:isDisjointFrom "isDisjointFrom")
SubClassOf(sbol:isDisjointFrom sbol:ConstraintRestriction)

# Class: sbol:meets (meets)

AnnotationAssertion(rdfs:comment sbol:meets "The subject and object are connected at a shared boundary.")
AnnotationAssertion(rdfs:label sbol:meets "meets")
SubClassOf(sbol:meets sbol:ConstraintRestriction)

# Class: sbol:mergeRoles (mergeRoles)

AnnotationAssertion(rdfs:comment sbol:mergeRoles "Use the union of the two sets: both the set of zero or more role properties given for this SubComponent as well as the set of zero or more role properties given for the included Component.")
AnnotationAssertion(rdfs:label sbol:mergeRoles "mergeRoles")
SubClassOf(sbol:mergeRoles sbol:RoleIntegration)

# Class: sbol:one (one)

AnnotationAssertion(rdfs:comment sbol:one "Exactly one Feature in the derived Component SHOULD have a prov:wasDerivedFrom property that refers to the template Feature.")
AnnotationAssertion(rdfs:label sbol:one "one")
SubClassOf(sbol:one sbol:Cardinality)

# Class: sbol:oneOrMore (OneOrMore)

AnnotationAssertion(rdfs:comment sbol:oneOrMore "At least one Feature in the derived Component SHOULD have a prov:wasDerivedFrom property that refers to the template Feature.")
AnnotationAssertion(rdfs:label sbol:oneOrMore "OneOrMore")
SubClassOf(sbol:oneOrMore sbol:Cardinality)

# Class: sbol:oppositeOrientationAs (oppositeOrientationAs)

AnnotationAssertion(rdfs:comment sbol:oppositeOrientationAs "The subject and object Component objects MUST have opposite orientations.")
AnnotationAssertion(rdfs:label sbol:oppositeOrientationAs "oppositeOrientationAs")
SubClassOf(sbol:oppositeOrientationAs sbol:OrientationRestriction)

# Class: sbol:overlaps (overlaps)

AnnotationAssertion(rdfs:comment sbol:overlaps "The subject and object overlap in space, but portions of each are outside of the other.")
AnnotationAssertion(rdfs:label sbol:overlaps "overlaps")
SubClassOf(sbol:overlaps sbol:ConstraintRestriction)

# Class: sbol:overrideRoles (overrideRoles)

AnnotationAssertion(rdfs:comment sbol:overrideRoles "In the context of this SubComponent, ignore any role given for the included Component. Instead use only the set of zero or more role properties given for this SubComponent.")
AnnotationAssertion(rdfs:label sbol:overrideRoles "overrideRoles")
SubClassOf(sbol:overrideRoles sbol:RoleIntegration)

# Class: sbol:precedes (precedes)

AnnotationAssertion(rdfs:comment sbol:precedes "The start of the location for subject is less than the start of the location for object.")
AnnotationAssertion(rdfs:label sbol:precedes "precedes")
SubClassOf(sbol:precedes sbol:ConstraintRestriction)

# Class: sbol:replaces (replaces)

AnnotationAssertion(rdfs:comment sbol:replaces "In the context of the parent object of the Constraint, information about the subject should be used in place of all instances of the object. Example: the J23101 promoter replaces a generic promoter.")
AnnotationAssertion(rdfs:label sbol:replaces "replaces")
SubClassOf(sbol:replaces sbol:ConstraintRestriction)

# Class: sbol:reverseComplement (reverseComplement)

AnnotationAssertion(rdfs:comment sbol:reverseComplement "Reverse complement is an attribute of the feature, where the feature is in the 3' to 5' direction.")
AnnotationAssertion(rdfs:label sbol:reverseComplement "reverseComplement")
SubClassOf(sbol:reverseComplement sbol:Orientation)

# Class: sbol:sameOrientationAs (sameOrientationAs)

AnnotationAssertion(rdfs:comment sbol:sameOrientationAs "The subject and object Component objects MUST have the same orientation. ")
AnnotationAssertion(rdfs:label sbol:sameOrientationAs "sameOrientationAs")
SubClassOf(sbol:sameOrientationAs sbol:OrientationRestriction)

# Class: sbol:sample (sample)

AnnotationAssertion(rdfs:comment sbol:sample "Sample is a strategy for deriving new Components from a template Component. The sample strategy specifies that a new Component should be derived for a random sample of the possible combinations of values for the variable specified by the VariableFeature objects in the template Component.")
AnnotationAssertion(rdfs:label sbol:sample "sample")
SubClassOf(sbol:sample sbol:CombinatorialDerivationStrategy)

# Class: sbol:starts (starts)

AnnotationAssertion(rdfs:comment sbol:starts "The start of the location for subject is equal to the start of the location for object and the end of the location for subject is before the end of the location for object.")
AnnotationAssertion(rdfs:label sbol:starts "starts")
SubClassOf(sbol:starts sbol:ConstraintRestriction)

# Class: sbol:strictlyContains (strictlyContains)

AnnotationAssertion(rdfs:comment sbol:strictlyContains "The subject entirely contains the object: they do not share a boundary.")
AnnotationAssertion(rdfs:label sbol:strictlyContains "strictlyContains")
SubClassOf(sbol:strictlyContains sbol:ConstraintRestriction)

# Class: sbol:strictlyPrecedes (strictlyPrecedes)

AnnotationAssertion(rdfs:comment sbol:strictlyPrecedes "The end of the location for subject is less than the start of the location for object.")
AnnotationAssertion(rdfs:label sbol:strictlyPrecedes "strictlyPrecedes")
SubClassOf(sbol:strictlyPrecedes sbol:ConstraintRestriction)

# Class: sbol:verifyIdentical (verifyIdentical)

AnnotationAssertion(rdfs:comment sbol:verifyIdentical "The subject and object, after tracing through any layers of ComponentReference, MUST both refer to SubComponent objects with the same instanceOf value or both refer to ExternallyDefined objects with the same definition. Example: a promoter included via two different subsystems must be the identical.")
AnnotationAssertion(rdfs:label sbol:verifyIdentical "verifyIdentical")
SubClassOf(sbol:verifyIdentical sbol:ConstraintRestriction)

# Class: sbol:zeroOrMore (zeroOrMore)

AnnotationAssertion(rdfs:comment sbol:zeroOrMore "Any number of Feature objects in the derived Component MAY have prov:wasDerivedFrom properties that refer to the template Feature.")
AnnotationAssertion(rdfs:label sbol:zeroOrMore "zeroOrMore")
SubClassOf(sbol:zeroOrMore sbol:Cardinality)

# Class: sbol:zeroOrOne (zeroOrOne)

AnnotationAssertion(rdfs:comment sbol:zeroOrOne "No more than one Feature in the derived Component SHOULD have a prov:wasDerivedFrom property that refers to the template Feature.")
AnnotationAssertion(rdfs:label sbol:zeroOrOne "zeroOrOne")
SubClassOf(sbol:zeroOrOne sbol:Cardinality)

# Class: om:BinaryPrefix (BinaryPrefix)

AnnotationAssertion(rdfs:comment om:BinaryPrefix "The purpose of the om:BinaryPrefix class is to describe standard binary prefixes such as \"kibi\", \"mebi\", \"gibi\", etc.")
AnnotationAssertion(rdfs:label om:BinaryPrefix "BinaryPrefix")
SubClassOf(om:BinaryPrefix om:Prefix)

# Class: om:CompoundUnit (CompoundUnit)

AnnotationAssertion(rdfs:comment om:CompoundUnit "om:CompoundUnit is an abstract class that is extended by other classes to describe units of measure that can be represented as combinations of multiple other units of measure.")
AnnotationAssertion(rdfs:label om:CompoundUnit "CompoundUnit")
SubClassOf(om:CompoundUnit om:Unit)

# Class: om:Measure (Measure)

AnnotationAssertion(rdfs:comment om:Measure "The purpose of the om:Measure class is to link a numerical value to a om:Unit.")
AnnotationAssertion(rdfs:label om:Measure "Measure")
SubClassOf(om:Measure owl:Thing)
SubClassOf(om:Measure ObjectSomeValuesFrom(om:hasUnit om:Unit))
SubClassOf(om:Measure DataSomeValuesFrom(om:hasNumericalValue xsd:decimal))

# Class: om:Prefix (Prefix)

AnnotationAssertion(rdfs:comment om:Prefix "om:Prefix is an abstract class that is extended by other classes to describe factors that are  commonly represented by standard unit prefixes.")
AnnotationAssertion(rdfs:label om:Prefix "Prefix")
SubClassOf(om:Prefix owl:Thing)
SubClassOf(om:Prefix DataSomeValuesFrom(om:hasFactor xsd:decimal))
SubClassOf(om:Prefix DataSomeValuesFrom(om:symbol xsd:string))
SubClassOf(om:Prefix DataSomeValuesFrom(rdfs:label xsd:string))

# Class: om:PrefixedUnit (PrefixedUnit)

AnnotationAssertion(rdfs:comment om:PrefixedUnit "The purpose of the om:PrefixedUnit class is to describe a unit of measure that is the multiplication of another unit of measure and a factor represented by a standard prefix such as \"milli\", \"centi\", \"kilo\", etc.")
AnnotationAssertion(rdfs:label om:PrefixedUnit "PrefixedUnit")
SubClassOf(om:PrefixedUnit om:Unit)
SubClassOf(om:PrefixedUnit ObjectSomeValuesFrom(om:hasPrefix om:Prefix))
SubClassOf(om:PrefixedUnit ObjectSomeValuesFrom(om:hasUnit om:Unit))

# Class: om:SIPrefix (SIPrefix)

AnnotationAssertion(rdfs:comment om:SIPrefix "The purpose of the om:SIPrefix class is to describe standard SI prefixes such as \"milli\", \"centi\", \"kilo\", etc.")
AnnotationAssertion(rdfs:label om:SIPrefix "SIPrefix")
SubClassOf(om:SIPrefix om:Prefix)

# Class: om:SingularUnit (SingularUnit)

AnnotationAssertion(rdfs:comment om:SingularUnit "The purpose of the om:SingularUnit class is to describe a unit of measure that is not explicitly represented as a combination of multiple units, but could be equivalent to such a representation.")
AnnotationAssertion(rdfs:label om:SingularUnit "SingularUnit")
SubClassOf(om:SingularUnit om:Unit)

# Class: om:Unit (Unit)

AnnotationAssertion(rdfs:comment om:Unit "om:Unit is an abstract class that is extended by other classes to describe units of measure using a shared set of properties.")
AnnotationAssertion(rdfs:label om:Unit "Unit")
SubClassOf(om:Unit owl:Thing)
SubClassOf(om:Unit DataSomeValuesFrom(om:symbol xsd:string))
SubClassOf(om:Unit DataSomeValuesFrom(rdfs:label xsd:string))

# Class: om:UnitDivision (UnitDivision)

AnnotationAssertion(rdfs:comment om:UnitDivision "The purpose of the om:UnitDivision class is to describe a unit of measure that is the division of one unit of measure by another.")
AnnotationAssertion(rdfs:label om:UnitDivision "UnitDivision")
SubClassOf(om:UnitDivision om:Unit)
SubClassOf(om:UnitDivision ObjectSomeValuesFrom(om:hasDenominator om:Unit))
SubClassOf(om:UnitDivision ObjectSomeValuesFrom(om:hasNumerator om:Unit))

# Class: om:UnitExponentiation (UnitExponentiation)

AnnotationAssertion(rdfs:comment om:UnitExponentiation "The purpose of the om:UnitExponentiation class is to describe a unit of measure that is raised to an integer power.")
AnnotationAssertion(rdfs:label om:UnitExponentiation "UnitExponentiation")
SubClassOf(om:UnitExponentiation om:Unit)
SubClassOf(om:UnitExponentiation ObjectSomeValuesFrom(om:hasBase om:Unit))
SubClassOf(om:UnitExponentiation DataSomeValuesFrom(om:hasExponent xsd:integer))

# Class: om:UnitMultiplication (UnitMultiplication)

AnnotationAssertion(rdfs:comment om:UnitMultiplication "The purpose of the om:UnitMultiplication class is to describe a unit of measure that is the multiplication of two other units of measure.")
AnnotationAssertion(rdfs:label om:UnitMultiplication "UnitMultiplication")
SubClassOf(om:UnitMultiplication om:Unit)
SubClassOf(om:UnitMultiplication ObjectSomeValuesFrom(om:hasTerm1 om:Unit))
SubClassOf(om:UnitMultiplication ObjectSomeValuesFrom(om:hasTerm2 om:Unit))

# Class: identifiers:CHEBI:35224 (effector)

AnnotationAssertion(rdfs:comment identifiers:CHEBI:35224 "A small molecule which increases (activator) or decreases (inhibitor) the activity of an (allosteric) enzyme by binding to the enzyme at the regulatory site (which is different from the substrate-binding catalytic site).")
AnnotationAssertion(rdfs:label identifiers:CHEBI:35224 "effector")
SubClassOf(identifiers:CHEBI:35224 identifiers:CHEBI:50906)

# Class: identifiers:CHEBI:50906 (material entity role)

AnnotationAssertion(rdfs:comment identifiers:CHEBI:50906 "A role is particular behaviour which a material entity may exhibit.")
AnnotationAssertion(rdfs:label identifiers:CHEBI:50906 "material entity role")
SubClassOf(identifiers:CHEBI:50906 owl:Thing)

# Class: identifiers:GO:0003674 (molecular_function)

AnnotationAssertion(rdfs:comment identifiers:GO:0003674 "A molecular process that can be carried out by the action of a single macromolecular machine, usually via direct physical interactions with other molecular entities. Function in this sense denotes an action, or activity, that a gene product (or a complex) performs.")
AnnotationAssertion(rdfs:label identifiers:GO:0003674 "molecular_function")
SubClassOf(identifiers:GO:0003674 owl:Thing)

# Class: identifiers:GO:0003700 (DNA-binding transcription factor activity)

AnnotationAssertion(rdfs:comment identifiers:GO:0003700 "A transcription regulator activity that modulates transcription of gene sets via selective and non-covalent binding to a specific double-stranded genomic DNA sequence (sometimes referred to as a motif) within a cis-regulatory region. Regulatory regions include promoters (proximal and distal) and enhancers. Genes are transcriptional units, and include bacterial operons.")
AnnotationAssertion(rdfs:label identifiers:GO:0003700 "DNA-binding transcription factor activity")
SubClassOf(identifiers:GO:0003700 identifiers:GO:0003674)

# Class: identifiers:SBO:0000000 (systems biology representation)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000000 "Representation of an entity used in a systems biology knowledge reconstruction, such as a model, pathway, network.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000000 "systems biology representation")
SubClassOf(identifiers:SBO:0000000 owl:Thing)

# Class: identifiers:SBO:0000003 (participant role)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000003 "The function of a physical or conceptual entity, that is its role, in the execution of an event or process.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000003 "participant role")
SubClassOf(identifiers:SBO:0000003 identifiers:SBO:0000000)

# Class: identifiers:SBO:0000004 (modelling framework)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000004 "Set of assumptions that underlay a mathematical description.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000004 "modelling framework")
SubClassOf(identifiers:SBO:0000004 identifiers:SBO:0000000)

# Class: identifiers:SBO:0000010 (reactant)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000010 "Substance consumed by a chemical reaction. Reactants react with each other to form the products of a chemical reaction. In a chemical equation the Reactants are the elements or compounds on the left hand side of the reaction equation. A reactant can be consumed and produced by the same reaction, its global quantity remaining unchanged.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000010 "reactant")
SubClassOf(identifiers:SBO:0000010 identifiers:SBO:0000003)

# Class: identifiers:SBO:0000011 (product)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000011 "Substance that is produced in a reaction. In a chemical equation the Products are the elements or compounds on the right hand side of the reaction equation. A product can be produced and consumed by the same reaction, its global quantity remaining unchanged.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000011 "product")
SubClassOf(identifiers:SBO:0000011 identifiers:SBO:0000003)

# Class: identifiers:SBO:0000019 (modifier)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000019 "Substance that changes the velocity of a process without itself being consumed or transformed by the reaction.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000019 "modifier")
SubClassOf(identifiers:SBO:0000019 identifiers:SBO:0000003)

# Class: identifiers:SBO:0000020 (inhibitor)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000020 "Substance that decreases the probability of a chemical reaction without itself being consumed or transformed by the reaction.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000020 "inhibitor")
SubClassOf(identifiers:SBO:0000020 identifiers:SBO:0000019)

# Class: identifiers:SBO:0000062 (continuous framework)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000062 "Modelling approach where the quantities of participants are considered continuous, and represented by real values. The associated simulation methods make use of differential equations.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000062 "continuous framework")
SubClassOf(identifiers:SBO:0000062 identifiers:SBO:0000004)

# Class: identifiers:SBO:0000063 (discrete framework)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000063 "Modelling approach where the quantities of participants are considered discrete, and represented by integer values. The associated simulation methods can be deterministic or stochastic.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000063 "discrete framework")
SubClassOf(identifiers:SBO:0000063 identifiers:SBO:0000004)

# Class: identifiers:SBO:0000167 (biochemical or transport reaction)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000167 "An event involving physical entities that results in modification of structure, location, or free energy.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000167 "biochemical or transport reaction")
SubClassOf(identifiers:SBO:0000167 identifiers:SBO:0000231)

# Class: identifiers:SBO:0000168 (control)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000168 "Synonym: regulation")
AnnotationAssertion(rdfs:label identifiers:SBO:0000168 "control")
SubClassOf(identifiers:SBO:0000168 identifiers:SBO:0000231)

# Class: identifiers:SBO:0000169 (inhibition)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000169 "Negative modulation of the execution of a process.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000169 "inhibition")
SubClassOf(identifiers:SBO:0000169 identifiers:SBO:0000168)

# Class: identifiers:SBO:0000170 (stimulation)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000170 "Positive modulation of the execution of a process.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000170 "stimulation")
SubClassOf(identifiers:SBO:0000170 identifiers:SBO:0000168)

# Class: identifiers:SBO:0000176 (biochemical reaction)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000176 "An event involving one or more chemical entities that modifies the electrochemical structure of at least one of the participants.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000176 "biochemical reaction")
SubClassOf(identifiers:SBO:0000176 identifiers:SBO:0000167)

# Class: identifiers:SBO:0000177 (non-covalent binding)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000177 "Synonym: association")
AnnotationAssertion(rdfs:label identifiers:SBO:0000177 "non-covalent binding")
SubClassOf(identifiers:SBO:0000177 identifiers:SBO:0000176)

# Class: identifiers:SBO:0000179 (degradation)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000179 "Complete disappearance of a physical entity.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000179 "degradation")
SubClassOf(identifiers:SBO:0000179 identifiers:SBO:0000176)

# Class: identifiers:SBO:0000231 (occurring entity representation)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000231 "Representation of an entity that manifests, unfolds or develops through time, such as a discrete event, or a mutual or reciprocal action or influence that happens between participating physical entities, and/or other occurring entities.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000231 "occurring entity representation")
SubClassOf(identifiers:SBO:0000231 identifiers:SBO:0000000)

# Class: identifiers:SBO:0000234 (logical framework)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000234 "Modelling approach, pioneered by Rene Thomas and Stuart Kaufman, where the evolution of a system is described by the transitions between discrete activity states of 'genes' that control each other.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000234 "logical framework")
SubClassOf(identifiers:SBO:0000234 identifiers:SBO:0000004)

# Class: identifiers:SBO:0000236 (physical entity representation)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000236 "Synonym: new synonym")
AnnotationAssertion(rdfs:label identifiers:SBO:0000236 "physical entity representation")
SubClassOf(identifiers:SBO:0000236 identifiers:SBO:0000000)

# Class: identifiers:SBO:0000241 (functional entity)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000241 "A real thing, defined by its properties or the actions it performs, rather than it physico-chemical structure.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000241 "functional entity")
SubClassOf(identifiers:SBO:0000241 identifiers:SBO:0000236)

# Class: identifiers:SBO:0000247 (simple chemical)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000247 "Simple, non-repetitive chemical entity.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000247 "simple chemical")
SubClassOf(identifiers:SBO:0000247 identifiers:SBO:0000236)

# Class: identifiers:SBO:0000250 (ribonucleic acid)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000250 "Synonym: RNA")
AnnotationAssertion(rdfs:label identifiers:SBO:0000250 "ribonucleic acid")
SubClassOf(identifiers:SBO:0000250 identifiers:SBO:0000236)

# Class: identifiers:SBO:0000251 (deoxyribonucleic acid)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000251 "Synonym: DNA")
AnnotationAssertion(rdfs:label identifiers:SBO:0000251 "deoxyribonucleic acid")
SubClassOf(identifiers:SBO:0000251 identifiers:SBO:0000236)

# Class: identifiers:SBO:0000252 (polypeptide chain)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000252 "Naturally occurring macromolecule formed by the repetition of amino-acid residues linked by peptidic bonds. A polypeptide chain is synthesized by the ribosome.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000252 "polypeptide chain")
SubClassOf(identifiers:SBO:0000252 identifiers:SBO:0000236)

# Class: identifiers:SBO:0000253 (non-covalent complex)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000253 "Entity composed of several independant components that are not linked by covalent bonds.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000253 "non-covalent complex")
SubClassOf(identifiers:SBO:0000253 identifiers:SBO:0000236)

# Class: identifiers:SBO:0000289 (functional compartment)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000289 "Logical or physical subset of the event space that contains pools, that is sets of participants considered identical when it comes to the event they are involved into. A compartment can have any number of dimensions, including 0, and be of any size including null.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000289 "functional compartment")
SubClassOf(identifiers:SBO:0000289 identifiers:SBO:0000003)

# Class: identifiers:SBO:0000459 (stimulator)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000459 "Synonym: activator")
AnnotationAssertion(rdfs:label identifiers:SBO:0000459 "stimulator")
SubClassOf(identifiers:SBO:0000459 identifiers:SBO:0000019)

# Class: identifiers:SBO:0000589 (genetic production)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000589 "A composite biochemical process through which a gene sequence is fully converted into mature gene products. These gene products may include RNA species as well as proteins, and the process encompasses all intermediate steps required to generate the active form of the gene product.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000589 "genetic production")
SubClassOf(identifiers:SBO:0000589 identifiers:SBO:0000231)

# Class: identifiers:SBO:0000598 (promoter)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000598 "A region of DNA to which various transcription factors and RNA polymerase must bind in order to initiate transcription for a gene.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000598 "promoter")
SubClassOf(identifiers:SBO:0000598 identifiers:SBO:0000003)

# Class: identifiers:SBO:0000642 (inhibited)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000642 "Conceptual or material entity that is the object of an inhibition process, and is acted upon by an inhibitor.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000642 "inhibited")
SubClassOf(identifiers:SBO:0000642 identifiers:SBO:0000003)

# Class: identifiers:SBO:0000643 (stimulated)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000643 "Conceptual or material entity that is the object of a stimulation process, and is acted upon by a stimulator.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000643 "stimulated")
SubClassOf(identifiers:SBO:0000643 identifiers:SBO:0000003)

# Class: identifiers:SBO:0000644 (modified)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000644 "Conceptual or material entity that is the object of a modification process, and is acted upon by a modifier.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000644 "modified")
SubClassOf(identifiers:SBO:0000644 identifiers:SBO:0000003)

# Class: identifiers:SBO:0000645 (template)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000645 "An entity that acts as the starting material for genetic production (http://identifiers.org/biomodels.sbo/SBO:0000589).")
AnnotationAssertion(rdfs:label identifiers:SBO:0000645 "template")
SubClassOf(identifiers:SBO:0000645 identifiers:SBO:0000003)

# Class: identifiers:SBO:0000681 (hybrid framework)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000681 "Modeling approach which combines multiple canonical modeling frameworks. For example, a hybrid model could consider both continuous (represented by real values) and discrete (represented by integers) participants. Hybrid models are executed with hybrid simulation algorithms. For example, a hybrid continuous-discrete model may be simulation using a combination of stochastic simulation and ordinary differential equations.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000681 "hybrid framework")
SubClassOf(identifiers:SBO:0000681 identifiers:SBO:0000004)

# Class: identifiers:SBO:0000693 (constraint-based framework)

AnnotationAssertion(rdfs:comment identifiers:SBO:0000693 "Modelling approach which captures bounds on the possible behavior of a system, which may be further reduced using an objective function.")
AnnotationAssertion(rdfs:label identifiers:SBO:0000693 "constraint-based framework")
SubClassOf(identifiers:SBO:0000693 identifiers:SBO:0000004)

# Class: identifiers:SO:0000057 (operator)

AnnotationAssertion(rdfs:comment identifiers:SO:0000057 "Moved to transcriptional_cis_regulatory_region (SO:0001055) from gene_group_regulatory_region (SO:0000752) on 11 Feb 2021 when SO:0000752 was merged into SO:0001055. See GitHub Issue #529. A regulatory element of an operon to which activators or repressors bind thereby effecting translation of genes in that operon.")
AnnotationAssertion(rdfs:label identifiers:SO:0000057 "operator")
SubClassOf(identifiers:SO:0000057 identifiers:SO:0000110)

# Class: identifiers:SO:0000110 (sequence_feature)

AnnotationAssertion(rdfs:comment identifiers:SO:0000110 "Any extent of continuous biological sequence.")
AnnotationAssertion(rdfs:label identifiers:SO:0000110 "sequence_feature")
SubClassOf(identifiers:SO:0000110 owl:Thing)

# Class: identifiers:SO:0000139 (ribosome_entry_site)

AnnotationAssertion(rdfs:comment identifiers:SO:0000139 "Region in mRNA where ribosome assembles.")
AnnotationAssertion(rdfs:label identifiers:SO:0000139 "ribosome_entry_site")
SubClassOf(identifiers:SO:0000139 identifiers:SO:0000110)

# Class: identifiers:SO:0000141 (terminator)

AnnotationAssertion(rdfs:comment identifiers:SO:0000141 "Moved from transcription_regulatory_region (SO:0001679) to transcriptional_cis_regulatory_region (SO:0001055) by Dave Sant on Feb 11, 2021 when transcription_regulatory_region was merged into transcriptional_cis_regulatory_region to be consistent with GO and reduce redundancy as part of the GREEKC consortium. See GitHub Issue #527. The sequence of DNA located either at the end of the transcript that causes RNA polymerase to terminate transcription.")
AnnotationAssertion(rdfs:label identifiers:SO:0000141 "terminator")
SubClassOf(identifiers:SO:0000141 identifiers:SO:0000110)

# Class: identifiers:SO:0000167 (promoter)

AnnotationAssertion(rdfs:comment identifiers:SO:0000167 "This term is mapped to MGED. Do not obsolete without consulting MGED ontology. The region on a DNA molecule involved in RNA polymerase binding to initiate transcription. Moved from is_a: SO:0001055 transcriptional_cis_regulatory_region as per request from GREEKC initiative in August 2020. Merged with RNA_polymerase_promoter (SO:0001203) Aug 2020. Moved up one level from is_a CRM (SO:0000727) to is_a transcriptional_cis_regulatory_region (SO:0001055) as part of the GREEKC work January 2021. Pascale Gaudet from Gene Ontology pointed out that CRM can be located upstream of the promoter and therefore cannot include the promoter. A regulatory_region composed of the TSS(s) and binding sites for TF_complexes of the core transcription machinery. A region (DNA) to which RNA polymerase binds, to begin transcription.")
AnnotationAssertion(rdfs:label identifiers:SO:0000167 "promoter")
SubClassOf(identifiers:SO:0000167 identifiers:SO:0000110)

# Class: identifiers:SO:0000234 (mRNA)

AnnotationAssertion(rdfs:comment identifiers:SO:0000234 "An mRNA does not contain introns as it is a processed_transcript. The equivalent kind of primary_transcript is protein_coding_primary_transcript (SO:0000120) which may contain introns. This term is mapped to MGED. Do not obsolete without consulting MGED ontology. Messenger RNA is the intermediate molecule between DNA and protein. It includes UTR and coding sequences. It does not contain introns.")
AnnotationAssertion(rdfs:label identifiers:SO:0000234 "mRNA")
SubClassOf(identifiers:SO:0000234 identifiers:SO:0000110)

# Class: identifiers:SO:0000316 (CDS)

AnnotationAssertion(rdfs:comment identifiers:SO:0000316 "A contiguous sequence which begins with, and includes, a start codon and ends with, and includes, a stop codon.")
AnnotationAssertion(rdfs:label identifiers:SO:0000316 "CDS")
SubClassOf(identifiers:SO:0000316 identifiers:SO:0000110)

# Class: identifiers:SO:0000400 (sequence_attribute)

AnnotationAssertion(rdfs:comment identifiers:SO:0000400 "An attribute describes a quality of sequence.")
AnnotationAssertion(rdfs:label identifiers:SO:0000400 "sequence_attribute")
SubClassOf(identifiers:SO:0000400 owl:Thing)

# Class: identifiers:SO:0000704 (gene)

AnnotationAssertion(rdfs:comment identifiers:SO:0000704 "This term is mapped to MGED. Do not obsolete without consulting MGED ontology. A gene may be considered as a unit of inheritance. A region (or regions) that includes all of the sequence elements necessary to encode a functional transcript. A gene may include regulatory regions, transcribed regions and/or other functional sequence regions.")
AnnotationAssertion(rdfs:label identifiers:SO:0000704 "gene")
SubClassOf(identifiers:SO:0000704 identifiers:SO:0000110)

# Class: identifiers:SO:0000804 (engineered_region)

AnnotationAssertion(rdfs:comment identifiers:SO:0000804 "A region that is engineered.")
AnnotationAssertion(rdfs:label identifiers:SO:0000804 "engineered_region")
SubClassOf(identifiers:SO:0000804 identifiers:SO:0000110)

# Class: identifiers:SO:0000984 (single)

AnnotationAssertion(rdfs:comment identifiers:SO:0000984 "Attributes added to describe the different kinds of replicon. SO workshop, September 2006. When a nucleotide polymer has only one strand.")
AnnotationAssertion(rdfs:label identifiers:SO:0000984 "single")
SubClassOf(identifiers:SO:0000984 identifiers:SO:0000400)

# Class: identifiers:SO:0000985 (double)

AnnotationAssertion(rdfs:comment identifiers:SO:0000985 "Attributes added to describe the different kinds of replicon. SO workshop, September 2006. When a nucleotide polymer has two strands that are reverse-complement to one another and pair together.")
AnnotationAssertion(rdfs:label identifiers:SO:0000985 "double")
SubClassOf(identifiers:SO:0000985 identifiers:SO:0000400)

# Class: identifiers:SO:0000987 (linear)

AnnotationAssertion(rdfs:comment identifiers:SO:0000987 "Attributes added to describe the different kinds of replicon. SO workshop, September 2006. A quality of a nucleotide polymer that has a 3'-terminal residue and a 5'-terminal residue.")
AnnotationAssertion(rdfs:label identifiers:SO:0000987 "linear")
SubClassOf(identifiers:SO:0000987 identifiers:SO:0000400)

# Class: identifiers:SO:0000988 (circular)

AnnotationAssertion(rdfs:comment identifiers:SO:0000988 "Attributes added to describe the different kinds of replicon. SO workshop, September 2006. A quality of a nucleotide polymer that has no terminal nucleotide residues.")
AnnotationAssertion(rdfs:label identifiers:SO:0000988 "circular")
SubClassOf(identifiers:SO:0000988 identifiers:SO:0000400)

# Class: identifiers:SO:0001030 (forward)

AnnotationAssertion(rdfs:comment identifiers:SO:0001030 "Forward is an attribute of the feature, where the feature is in the 5' to 3' direction.")
AnnotationAssertion(rdfs:label identifiers:SO:0001030 "forward")
SubClassOf(identifiers:SO:0001030 identifiers:SO:0000400)

# Class: identifiers:SO:0001031 (reverse)

AnnotationAssertion(rdfs:comment identifiers:SO:0001031 "Reverse is an attribute of the feature, where the feature is in the 3' to 5' direction. Again could be applied to primer.")
AnnotationAssertion(rdfs:label identifiers:SO:0001031 "reverse")
SubClassOf(identifiers:SO:0001031 identifiers:SO:0000400)

# Class: identifiers:format_1196 (SMILES)

AnnotationAssertion(rdfs:comment identifiers:edam:format_1196 "Chemical structure specified in Simplified Molecular Input Line Entry System (SMILES) line notation.")
AnnotationAssertion(rdfs:label identifiers:edam:format_1196 "SMILES")
SubClassOf(identifiers:edam:format_1196 identifiers:edam:format_1915)

# Class: identifiers:format_1197 (InChI)

AnnotationAssertion(rdfs:comment identifiers:edam:format_1197 "Chemical structure specified in IUPAC International Chemical Identifier (InChI) line notation.")
AnnotationAssertion(rdfs:label identifiers:edam:format_1197 "InChI")
SubClassOf(identifiers:edam:format_1197 identifiers:edam:format_1915)

# Class: identifiers:format_1207 (nucleotide)

AnnotationAssertion(rdfs:comment identifiers:edam:format_1207 "Alphabet for a nucleotide sequence with possible ambiguity, unknown positions and non-sequence characters.")
AnnotationAssertion(rdfs:label identifiers:edam:format_1207 "nucleotide")
SubClassOf(identifiers:edam:format_1207 identifiers:edam:format_1915)

# Class: identifiers:format_1208 (protein)

AnnotationAssertion(rdfs:comment identifiers:edam:format_1208 "Alphabet for a protein sequence with possible ambiguity, unknown positions and non-sequence characters.")
AnnotationAssertion(rdfs:label identifiers:edam:format_1208 "protein")
SubClassOf(identifiers:edam:format_1208 identifiers:edam:format_1915)

# Class: identifiers:format_1915 (Format)

AnnotationAssertion(rdfs:comment identifiers:edam:format_1915 "A defined way or layout of representing and structuring data in a computer file, blob, string, message, or elsewhere.")
AnnotationAssertion(rdfs:label identifiers:edam:format_1915 "Format")
SubClassOf(identifiers:edam:format_1915 owl:Thing)

# Class: identifiers:format_2585 (SBML)

AnnotationAssertion(rdfs:comment identifiers:edam:format_2585 "Systems Biology Markup Language (SBML), the standard XML format for models of biological processes such as for example metabolism, cell signaling, and gene regulation.")
AnnotationAssertion(rdfs:label identifiers:edam:format_2585 "SBML")
SubClassOf(identifiers:edam:format_2585 identifiers:edam:format_1915)

# Class: identifiers:format_3156 (BioPAX)

AnnotationAssertion(rdfs:comment identifiers:edam:format_3156 "BioPAX is an exchange format for pathway data, with its data model defined in OWL.")
AnnotationAssertion(rdfs:label identifiers:edam:format_3156 "BioPAX")
SubClassOf(identifiers:edam:format_3156 identifiers:edam:format_1915)

# Class: identifiers:format_3240 (CellML)

AnnotationAssertion(rdfs:comment identifiers:edam:format_3240 "CellML, the format for mathematical models of biological and other networks.")
AnnotationAssertion(rdfs:label identifiers:edam:format_3240 "CellML")
SubClassOf(identifiers:edam:format_3240 identifiers:edam:format_1915)

# Class: prov:Activity (Activity)

AnnotationAssertion(rdfs:comment prov:Activity "An Activity is used to represent the execution of a process or set of processes. An Activity is linked through prov:qualifiedAssociation to one or more Associations, and is linked through prov:used to one or more Entities.")
AnnotationAssertion(rdfs:label prov:Activity "Activity")
SubClassOf(prov:Activity owl:Thing)

# Class: prov:Agent (Agent)

AnnotationAssertion(rdfs:comment prov:Agent "An Agent is something that bears some form of responsibility for an Activity taking place, such as a person, organization, or software agent.")
AnnotationAssertion(rdfs:label prov:Agent "Agent")
SubClassOf(prov:Agent owl:Thing)

# Class: prov:Association (Association)

AnnotationAssertion(rdfs:comment prov:Association "An Association is used to link an Activity to one or more Agents, and to describe the role of each Agent in the execution of the Activity. An Association is linked through prov:qualifiedAssociation to an Activity, and is linked through prov:agent to one or more Agents.")
AnnotationAssertion(rdfs:label prov:Association "Association")
SubClassOf(prov:Association owl:Thing)
SubClassOf(prov:Association ObjectSomeValuesFrom(prov:agent prov:Agent))

# Class: prov:Plan (Plan)

AnnotationAssertion(rdfs:comment prov:Plan "A Plan is used to describe a set of actions or steps intended to achieve a specific goal or outcome.")
AnnotationAssertion(rdfs:label prov:Plan "Plan")
SubClassOf(prov:Plan owl:Thing)

# Class: prov:Usage (Usage)

AnnotationAssertion(rdfs:comment prov:Usage "A Usage is used to describe the involvement of an Entity in an Activity, specifying how the Entity was used during the execution of the Activity.")
AnnotationAssertion(rdfs:label prov:Usage "Usage")
SubClassOf(prov:Usage owl:Thing)


DisjointClasses(sbol:Attachment sbol:Collection sbol:CombinatorialDerivation sbol:Component sbol:ExperimentalData sbol:Implementation sbol:Model sbol:SBOLActivity sbol:SBOLAgent sbol:SBOLBinaryPrefix sbol:SBOLCompoundUnit sbol:SBOLMeasure sbol:SBOLPlan sbol:SBOLPrefixedUnit sbol:SBOLSIPrefix sbol:SBOLSingularUnit sbol:SBOLUnitDivision sbol:SBOLUnitExponentiation sbol:SBOLUnitMultiplication sbol:Sequence)
DisjointClasses(sbol:ComponentReference sbol:ExternallyDefined sbol:LocalSubComponent sbol:SequenceFeature sbol:SubComponent)
DisjointClasses(sbol:Cut sbol:EntireSequence sbol:Range)
)